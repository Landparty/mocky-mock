TESTSUITE "INTCALC"

TESTCASE "2100-FETCH-ACCOUNT: WHEN OTHER"
    MOCK OPEN INTRPT
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "AAO" TO HV-ACCT-TYPE
        MOVE 721394.49 TO HV-CURRENT-BALANCE
        MOVE 65.372244 TO HV-INTEREST-RATE
        MOVE 2967545221023.47 TO HV-INTEREST-ACCRUED
        MOVE -2302683873139.34 TO HV-INTEREST-YTD
        MOVE "JOHNSON" TO HV-INT-LAST-PAID
        MOVE "TC" TO HV-STMT-CYCLE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE "T" TO IP-FUNC
        MOVE "U" TO IP-ACCT-TYPE
        MOVE 892173.00 TO IP-BALANCE
        MOVE 31.192203 TO IP-ANNUAL-RATE
        MOVE -6499 TO IP-CALC-DAYS
        MOVE -821414.54 TO IP-INTEREST-AMT
        MOVE "IZ" TO IP-RETURN-CODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE INTRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET INTEREST_ACCRUED"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. DAILY_BALANCE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET CURRENT_BALANCE"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN INTRPT WAS CALLED 1 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY CALL "INTRATE" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-INT-RATE-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY SQL "ROLLBACK" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE INTRPT WAS CALLED 1 TIMES

TESTCASE "empty input"
    MOCK OPEN INTRPT
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "TIZ" TO HV-ACCT-TYPE
        MOVE 51546.40 TO HV-CURRENT-BALANCE
        MOVE 40.744137 TO HV-INTEREST-RATE
        MOVE 6607736034037.59 TO HV-INTEREST-ACCRUED
        MOVE 1764267776361.80 TO HV-INTEREST-YTD
        MOVE "MARTIN" TO HV-INT-LAST-PAID
        MOVE "26" TO HV-STMT-CYCLE
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE "6" TO IP-FUNC
        MOVE "E" TO IP-ACCT-TYPE
        MOVE 969053.07 TO IP-BALANCE
        MOVE 2.210624 TO IP-ANNUAL-RATE
        MOVE 7890 TO IP-CALC-DAYS
        MOVE -760494.55 TO IP-INTEREST-AMT
        MOVE "GT" TO IP-RETURN-CODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE INTRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET INTEREST_ACCRUED"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. DAILY_BALANCE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET CURRENT_BALANCE"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN INTRPT WAS CALLED 1 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY CALL "INTRATE" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-INT-RATE-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY SQL "ROLLBACK" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE INTRPT WAS CALLED 1 TIMES
