TESTSUITE "DORMACCT dormant account identification"

*> ---------------------------------------------------------------------
*> Business rule under test (DORMACCT.cbl 2200-DETERMINE-DORM-STATUS):
*>   IF   last-activity-date <  escheatment-cutoff-date  -> escheat (2300)
*>   ELSE IF last-activity-date <  dormancy-cutoff-date   -> flag dormant (2400)
*>   ELSE                                                 -> leave alone
*> Both cutoff dates are computed once in 1000-INITIALIZE via
*> "business-date MINUS n YEARS" SQL and held in HV-DORM-CUTOFF-DATE /
*> HV-ESCH-CUTOFF-DATE for the life of the run. Every test below pins
*> those two host variables directly (via the two SELECT mocks or,
*> for paragraph-level tests, via a setup MOVE) so the dormancy/
*> escheatment math is exercised deterministically regardless of the
*> real system clock.
*> ---------------------------------------------------------------------

*> Happy path: parm card is read, both cutoff dates are computed, and the
*> cursor opens cleanly.
TESTCASE "1000-INITIALIZE reads the parm card and computes both cutoff dates"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
        MOVE 7 TO WS-PARM-DORM-YEARS
        MOVE 10 TO WS-PARM-ESCH-YEARS
        MOVE "TX" TO WS-PARM-STATE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-PARM-DORM-YEARS TO BE 7
    EXPECT WS-PARM-ESCH-YEARS TO BE 10
    EXPECT WS-PARM-STATE TO BE "TX"
    EXPECT HV-DORM-CUTOFF-DATE TO BE "2020-01-01"
    EXPECT HV-ESCH-CUTOFF-DATE TO BE "2015-01-01"
    VERIFY OPEN PARMFILE WAS CALLED ONCE
    VERIFY OPEN DORMNOT WAS CALLED ONCE
    VERIFY OPEN ESCHRPT WAS CALLED ONCE
    VERIFY READ PARMFILE WAS CALLED ONCE
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED ONCE
    VERIFY SQL "OPEN" WAS CALLED ONCE

*> Error path: the DORM_CURSOR OPEN fails, so the run must abort with
*> RETURN-CODE 16 (1000-INITIALIZE's own STOP RUN) before a single
*> account is ever fetched -- proves the "IF SQLCODE NOT = 0 ... STOP RUN"
*> guard, not just that the rest of the program is reachable (every
*> boundary past it still needs a mock, since it is statically reachable).
TESTCASE "1000-INITIALIZE aborts the run when the DORM_CURSOR OPEN fails"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
        MOVE 7 TO WS-PARM-DORM-YEARS
        MOVE 10 TO WS-PARM-ESCH-YEARS
        MOVE "TX" TO WS-PARM-STATE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE -805 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH"
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT RETURN-CODE TO BE 16
    EXPECT WS-ACCTS-EVALUATED TO BE 0
    VERIFY SQL "OPEN" WAS CALLED ONCE
    VERIFY SQL "FETCH" WAS CALLED NEVER
    VERIFY SQL "COMMIT" WAS CALLED NEVER
    VERIFY SQL "CLOSE" WAS CALLED NEVER
    VERIFY CLOSE PARMFILE WAS CALLED NEVER

*> Boundary: an account whose last activity is exactly ON the dormancy
*> cutoff date must NOT be flagged -- the comparison is strictly "<".
TESTCASE "2200-DETERMINE-DORM-STATUS leaves an account exactly at the dormancy cutoff untouched"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-LAST-ACTIVITY-DATE
    MOVE "ACCT00000101" TO HV-ACCT-NUMBER
    MOVE 2500.00 TO HV-CURRENT-BALANCE
    MOVE "ALICE" TO HV-FIRST-NAME
    MOVE "NGUYEN" TO HV-LAST-NAME
    PERFORM 2200-DETERMINE-DORM-STATUS
    EXPECT WS-DORM-FLAGGED TO BE 0
    EXPECT WS-ESCH-CANDIDATES TO BE 0
    EXPECT WS-TOTAL-DORM-BAL TO BE 0
    EXPECT WS-TOTAL-ESCH-BAL TO BE 0
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'" WAS CALLED NEVER
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'" WAS CALLED NEVER
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED NEVER
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED NEVER

*> Past dormancy, not yet escheatment: flagged dormant, status set to
*> 'D', a notice is written, and its balance rolls into the dormant total.
TESTCASE "2200-DETERMINE-DORM-STATUS flags an account as dormant once it crosses the dormancy threshold"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    MOVE "2017-06-15" TO HV-LAST-ACTIVITY-DATE
    MOVE "ACCT00000102" TO HV-ACCT-NUMBER
    MOVE 4200.50 TO HV-CURRENT-BALANCE
    MOVE "BENJAMIN" TO HV-FIRST-NAME
    MOVE "CARTER" TO HV-LAST-NAME
    PERFORM 2200-DETERMINE-DORM-STATUS
    EXPECT WS-DORM-FLAGGED TO BE 1
    EXPECT WS-NOTES-GENERATED TO BE 1
    EXPECT WS-TOTAL-DORM-BAL TO BE 4200.50
    EXPECT WS-ESCH-CANDIDATES TO BE 0
    EXPECT WS-DORM-ERRORS TO BE 0
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'" WAS CALLED ONCE
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED ONCE
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'" WAS CALLED NEVER
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED NEVER

*> Past escheatment: status set to 'E', a BSA regulatory record is
*> inserted, an escheatment report line is written, and its balance
*> rolls into the escheatment total instead of the dormant one.
TESTCASE "2200-DETERMINE-DORM-STATUS escheats an account whose last activity predates the escheatment cutoff"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    MOVE "2009-11-02" TO HV-LAST-ACTIVITY-DATE
    MOVE "ACCT00000103" TO HV-ACCT-NUMBER
    MOVE 9999.99 TO HV-CURRENT-BALANCE
    MOVE "CAROL" TO HV-FIRST-NAME
    MOVE "DIAZ" TO HV-LAST-NAME
    PERFORM 2200-DETERMINE-DORM-STATUS
    EXPECT WS-ESCH-CANDIDATES TO BE 1
    EXPECT WS-TOTAL-ESCH-BAL TO BE 9999.99
    EXPECT WS-DORM-FLAGGED TO BE 0
    EXPECT WS-DORM-ERRORS TO BE 0
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'" WAS CALLED ONCE
    VERIFY SQL "INSERT" WAS CALLED ONCE
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED ONCE
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'" WAS CALLED NEVER
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED NEVER

*> Boundary: an account exactly ON the escheatment cutoff must NOT be
*> escheated (strictly "<" again) -- it falls through to the dormancy
*> check instead, which it does cross, so it is flagged dormant, not
*> escheated.
TESTCASE "2200-DETERMINE-DORM-STATUS treats the escheatment cutoff boundary as still dormant"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    MOVE "2015-01-01" TO HV-LAST-ACTIVITY-DATE
    MOVE "ACCT00000104" TO HV-ACCT-NUMBER
    MOVE 1000.00 TO HV-CURRENT-BALANCE
    MOVE "DEREK" TO HV-FIRST-NAME
    MOVE "EVANS" TO HV-LAST-NAME
    PERFORM 2200-DETERMINE-DORM-STATUS
    EXPECT WS-ESCH-CANDIDATES TO BE 0
    EXPECT WS-DORM-FLAGGED TO BE 1
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'" WAS CALLED NEVER
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'" WAS CALLED ONCE

*> Error path: the escheatment UPDATE fails (e.g. a lock or constraint
*> violation) -- the candidate is still counted and its balance still
*> rolls into the escheatment total (both happen before the UPDATE), but
*> the regulatory INSERT and the report WRITE must never fire, and the
*> failure is tallied in WS-DORM-ERRORS.
TESTCASE "2300-PROCESS-ESCHEATMENT counts the candidate but skips the filing when the UPDATE fails"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE -803 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOVE "ACCT00000105" TO HV-ACCT-NUMBER
    MOVE 3300.00 TO HV-CURRENT-BALANCE
    MOVE "2005-01-01" TO HV-LAST-ACTIVITY-DATE
    MOVE "EVE" TO HV-FIRST-NAME
    MOVE "FRANKLIN" TO HV-LAST-NAME
    PERFORM 2300-PROCESS-ESCHEATMENT
    EXPECT WS-ESCH-CANDIDATES TO BE 1
    EXPECT WS-TOTAL-ESCH-BAL TO BE 3300.00
    EXPECT WS-DORM-ERRORS TO BE 1
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED NEVER

*> Error path: the dormant-flag UPDATE fails -- the flag is still
*> counted and its balance still rolls into the dormant total, but the
*> notification letter must never be written and the failure is tallied.
TESTCASE "2400-FLAG-AS-DORMANT counts the flag but skips the notice when the UPDATE fails"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE -803 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE "ACCT00000106" TO HV-ACCT-NUMBER
    MOVE 1800.25 TO HV-CURRENT-BALANCE
    MOVE "2018-01-01" TO HV-LAST-ACTIVITY-DATE
    MOVE "GRACE" TO HV-FIRST-NAME
    MOVE "HARRIS" TO HV-LAST-NAME
    PERFORM 2400-FLAG-AS-DORMANT
    EXPECT WS-DORM-FLAGGED TO BE 1
    EXPECT WS-TOTAL-DORM-BAL TO BE 1800.25
    EXPECT WS-NOTES-GENERATED TO BE 0
    EXPECT WS-DORM-ERRORS TO BE 1
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED NEVER
    VERIFY SQL "COMMIT" WAS CALLED NEVER

*> The batch-commit idiom: once WS-COMMIT-COUNT reaches WS-COMMIT-FREQ
*> (500) after a successful dormant flag, an interim COMMIT fires and
*> the counter resets to zero -- proves the unit-of-work isn't held open
*> for the whole run.
TESTCASE "2400-FLAG-AS-DORMANT issues an interim COMMIT once the commit frequency is reached"
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE 499 TO WS-COMMIT-COUNT
    MOVE "ACCT00000107" TO HV-ACCT-NUMBER
    MOVE 750.00 TO HV-CURRENT-BALANCE
    MOVE "2018-01-01" TO HV-LAST-ACTIVITY-DATE
    MOVE "IAN" TO HV-FIRST-NAME
    MOVE "JACKSON" TO HV-LAST-NAME
    PERFORM 2400-FLAG-AS-DORMANT
    EXPECT WS-DORM-FLAGGED TO BE 1
    EXPECT WS-COMMIT-COUNT TO BE 0
    VERIFY SQL "COMMIT" WAS CALLED ONCE
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED ONCE

*> A DB2 FETCH error (SQLCODE neither 0 nor +100) is fatal: the cursor
*> loop stops immediately, leaving any later accounts on the cursor
*> unprocessed. The one account fetched before the failure (a still-
*> active one here) is still evaluated normally.
TESTCASE "2000-PROCESS-DORMANT-ACCOUNTS stops the cursor loop on a FETCH failure"
    MOCK SQL "FETCH"
        EVALUATE TRUE
            WHEN UT-SQL-FETCH-TALLY = 1
                MOVE "ACCT00000108" TO HV-ACCT-NUMBER
                MOVE "CHK" TO HV-ACCT-TYPE
                MOVE "O" TO HV-ACCT-STATUS
                MOVE "CIF0000108" TO HV-CIF-NUMBER
                MOVE 640.00 TO HV-CURRENT-BALANCE
                MOVE "2023-07-01" TO HV-LAST-ACTIVITY-DATE
                MOVE "KAREN" TO HV-FIRST-NAME
                MOVE "LEWIS" TO HV-LAST-NAME
                MOVE "1 MAIN ST" TO HV-ADDR1
                MOVE "AUSTIN" TO HV-CITY
                MOVE "TX" TO HV-STATE
                MOVE "78701" TO HV-ZIP
                MOVE 0 TO SQLCODE
            WHEN OTHER
                MOVE -911 TO SQLCODE
        END-EVALUATE
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE 0 TO SQLCODE
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    PERFORM 2000-PROCESS-DORMANT-ACCOUNTS
    EXPECT WS-ACCTS-EVALUATED TO BE 1
    EXPECT WS-DORM-FLAGGED TO BE 0
    EXPECT WS-ESCH-CANDIDATES TO BE 0
    VERIFY SQL "FETCH" WAS CALLED 2 TIMES

*> An empty cursor (no accounts meet the SQL WHERE clause at all) must
*> evaluate zero accounts and flag nothing -- the loop guard's other arm.
TESTCASE "2000-PROCESS-DORMANT-ACCOUNTS evaluates zero accounts when the cursor is immediately empty"
    MOCK SQL "FETCH"
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOVE 0 TO SQLCODE
    MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
    MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
    PERFORM 2000-PROCESS-DORMANT-ACCOUNTS
    EXPECT WS-ACCTS-EVALUATED TO BE 0
    EXPECT WS-DORM-FLAGGED TO BE 0
    EXPECT WS-ESCH-CANDIDATES TO BE 0
    VERIFY SQL "FETCH" WAS CALLED ONCE

*> End-to-end error path: the one escheatable account's UPDATE fails
*> mid-run -- the run still completes (errors are logged, not fatal),
*> but 3000-FINALIZE's own "IF WS-DORM-ERRORS > ZERO" check must now
*> surface RETURN-CODE 4 to the job step instead of 0.
TESTCASE "0000-MAIN-PROCESS returns RETURN-CODE 4 when an account UPDATE fails during the run"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
        MOVE 7 TO WS-PARM-DORM-YEARS
        MOVE 10 TO WS-PARM-ESCH-YEARS
        MOVE "TX" TO WS-PARM-STATE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000301", HV-ACCT-TYPE = "SAV", HV-ACCT-STATUS = "O", HV-CIF-NUMBER = "CIF0000301", HV-CURRENT-BALANCE = 8800.00, HV-LAST-ACTIVITY-DATE = "2007-02-14", HV-FIRST-NAME = "RUTH", HV-LAST-NAME = "STEVENS", HV-ADDR1 = "9 BIRCH LN", HV-CITY = "EL PASO", HV-STATE = "TX", HV-ZIP = "79901" )
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE -803 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-ACCTS-EVALUATED TO BE 1
    EXPECT WS-ESCH-CANDIDATES TO BE 1
    EXPECT WS-DORM-ERRORS TO BE 1
    EXPECT RETURN-CODE TO BE 4
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED NEVER

*> End-to-end happy path: three accounts on the cursor -- one already
*> past escheatment, one past dormancy only, one still active -- driven
*> through the real 0000-MAIN-PROCESS entry point. Confirms the per-
*> account branching, the running totals, and a clean RETURN-CODE of 0.
*> Deliberately the LAST test case in this suite: RETURN-CODE is a
*> COBOL special register, not a WORKING-STORAGE item, so mockymock's
*> per-testcase reset never touches it -- it persists into the driver's
*> own closing STOP RUN. Ending on a success-path run keeps the compiled
*> binary's own process exit code 0, matching what every case marker
*> already reports.
TESTCASE "0000-MAIN-PROCESS end-to-end run separates escheated, dormant, and active accounts"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
        MOVE 7 TO WS-PARM-DORM-YEARS
        MOVE 10 TO WS-PARM-ESCH-YEARS
        MOVE "TX" TO WS-PARM-STATE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE "2020-01-01" TO HV-DORM-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE "2015-01-01" TO HV-ESCH-CUTOFF-DATE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000201", HV-ACCT-TYPE = "SAV", HV-ACCT-STATUS = "O", HV-CIF-NUMBER = "CIF0000201", HV-CURRENT-BALANCE = 1200.00, HV-LAST-ACTIVITY-DATE = "2008-05-01", HV-FIRST-NAME = "LARRY", HV-LAST-NAME = "MOORE", HV-ADDR1 = "10 OAK AVE", HV-CITY = "DALLAS", HV-STATE = "TX", HV-ZIP = "75201" )
        ( HV-ACCT-NUMBER = "ACCT00000202", HV-ACCT-TYPE = "CHK", HV-ACCT-STATUS = "O", HV-CIF-NUMBER = "CIF0000202", HV-CURRENT-BALANCE = 3300.00, HV-LAST-ACTIVITY-DATE = "2018-03-10", HV-FIRST-NAME = "NANCY", HV-LAST-NAME = "OWENS", HV-ADDR1 = "22 ELM ST", HV-CITY = "HOUSTON", HV-STATE = "TX", HV-ZIP = "77002" )
        ( HV-ACCT-NUMBER = "ACCT00000203", HV-ACCT-TYPE = "MMA", HV-ACCT-STATUS = "O", HV-CIF-NUMBER = "CIF0000203", HV-CURRENT-BALANCE = 500.00, HV-LAST-ACTIVITY-DATE = "2023-07-01", HV-FIRST-NAME = "PAULA", HV-LAST-NAME = "QUINN", HV-ADDR1 = "5 PINE RD", HV-CITY = "AUSTIN", HV-STATE = "TX", HV-ZIP = "78701" )
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-ACCTS-EVALUATED TO BE 3
    EXPECT WS-ESCH-CANDIDATES TO BE 1
    EXPECT WS-DORM-FLAGGED TO BE 1
    EXPECT WS-NOTES-GENERATED TO BE 1
    EXPECT WS-TOTAL-ESCH-BAL TO BE 1200.00
    EXPECT WS-TOTAL-DORM-BAL TO BE 3300.00
    EXPECT WS-DORM-ERRORS TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS CALLED 4 TIMES
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'E'" WAS CALLED ONCE
    VERIFY SQL "UPDATE BANK.ACCOUNT SET ACCT_STATUS = 'D'" WAS CALLED ONCE
    VERIFY SQL "INSERT" WAS CALLED ONCE
    VERIFY WRITE ESCH-RPT-RECORD WAS CALLED ONCE
    VERIFY WRITE DORM-NOTE-RECORD WAS CALLED 2 TIMES
    VERIFY SQL "COMMIT" WAS CALLED ONCE
    VERIFY SQL "CLOSE" WAS CALLED ONCE
    VERIFY CLOSE PARMFILE WAS CALLED ONCE
