TESTSUITE "DORMACCT"

TESTCASE "2100-FETCH-ACCOUNT: WHEN OTHER"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
        EVALUATE TRUE
            WHEN UT-READ-PARMFILE-TALLY = 1
                MOVE 24 TO WS-PARM-DORM-YEARS
                MOVE 65 TO WS-PARM-ESCH-YEARS
                MOVE "AL" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 2
                MOVE 70 TO WS-PARM-DORM-YEARS
                MOVE 42 TO WS-PARM-ESCH-YEARS
                MOVE "MI" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 3
                MOVE 2 TO WS-PARM-DORM-YEARS
                MOVE 64 TO WS-PARM-ESCH-YEARS
                MOVE "CT" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 4
                MOVE 20 TO WS-PARM-DORM-YEARS
                MOVE 81 TO WS-PARM-ESCH-YEARS
                MOVE "CA" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 5
                MOVE 1 TO WS-PARM-DORM-YEARS
                MOVE 4 TO WS-PARM-ESCH-YEARS
                MOVE "MI" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 6
                MOVE 89 TO WS-PARM-DORM-YEARS
                MOVE 62 TO WS-PARM-ESCH-YEARS
                MOVE "MA" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 7
                MOVE 27 TO WS-PARM-DORM-YEARS
                MOVE 10 TO WS-PARM-ESCH-YEARS
                MOVE "NJ" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 8
                MOVE 23 TO WS-PARM-DORM-YEARS
                MOVE 9 TO WS-PARM-ESCH-YEARS
                MOVE "IN" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 9
                MOVE 26 TO WS-PARM-DORM-YEARS
                MOVE 21 TO WS-PARM-ESCH-YEARS
                MOVE "IL" TO WS-PARM-STATE
            WHEN UT-READ-PARMFILE-TALLY = 10
                MOVE 73 TO WS-PARM-DORM-YEARS
                MOVE 40 TO WS-PARM-ESCH-YEARS
                MOVE "CA" TO WS-PARM-STATE
        END-EVALUATE
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "AAO" TO HV-ACCT-TYPE
        MOVE "H" TO HV-ACCT-STATUS
        MOVE "U4FWFK3VYI" TO HV-CIF-NUMBER
        MOVE 131091.56 TO HV-CURRENT-BALANCE
        MOVE "JOHNSON" TO HV-LAST-ACTIVITY-DATE
        MOVE "MARIA" TO HV-FIRST-NAME
        MOVE "MARTINEZ" TO HV-LAST-NAME
        MOVE "C8FINRDDFTLFP5A2TNZ46OPFXI8U9C1N" TO HV-ADDR1
        MOVE "SAN ANTONIO" TO HV-CITY
        MOVE "CA" TO HV-STATE
        MOVE "58283" TO HV-ZIP
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET ACCT_STATUS = E,"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET ACCT_STATUS = D,"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN PARMFILE WAS CALLED 1 TIMES
    VERIFY OPEN DORMNOT WAS CALLED 1 TIMES
    VERIFY OPEN ESCHRPT WAS CALLED 1 TIMES
    VERIFY READ PARMFILE WAS CALLED 10 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE PARMFILE WAS CALLED 1 TIMES
    EXPECT WS-DORM-HV.HV-ESCH-CUTOFF-DATE TO BE "2023-08-19"
    EXPECT WS-PARM-RECORD.WS-PARM-DORM-YEARS TO BE 62
    EXPECT WS-DORM-HV.HV-DORM-CUTOFF-DATE TO BE "1971-01-16"
    EXPECT WS-PARM-RECORD.WS-PARM-ESCH-YEARS TO BE 82

TESTCASE "empty input"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN DORMNOT
    END-MOCK
    MOCK OPEN ESCHRPT
    END-MOCK
    MOCK READ PARMFILE
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "TIZ" TO HV-ACCT-TYPE
        MOVE "H" TO HV-ACCT-STATUS
        MOVE "D5I0X44YR5" TO HV-CIF-NUMBER
        MOVE -706187.31 TO HV-CURRENT-BALANCE
        MOVE "DAVIS" TO HV-LAST-ACTIVITY-DATE
        MOVE "RICHARD" TO HV-FIRST-NAME
        MOVE "HERNANDEZ" TO HV-LAST-NAME
        MOVE "26GNHF7TQRJI5JBOVHIJ9PCQ3FEZXTO9" TO HV-ADDR1
        MOVE "PORTLAND" TO HV-CITY
        MOVE "GA" TO HV-STATE
        MOVE "79198" TO HV-ZIP
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    MOCK WRITE DORM-NOTE-RECORD
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-DORM-YEARS"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "SELECT CHAR ( DATE (:WS-BUSINESS-DATE ) - :WS-PARM-ESCH-YEARS"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET ACCT_STATUS = E,"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE ESCH-RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET ACCT_STATUS = D,"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN PARMFILE WAS CALLED 1 TIMES
    VERIFY OPEN DORMNOT WAS CALLED 1 TIMES
    VERIFY OPEN ESCHRPT WAS CALLED 1 TIMES
    VERIFY READ PARMFILE WAS CALLED 0 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE PARMFILE WAS CALLED 1 TIMES
    EXPECT WS-DORM-HV.HV-ESCH-CUTOFF-DATE TO BE "1972-04-12"
    EXPECT WS-PARM-RECORD.WS-PARM-DORM-YEARS TO BE 85
    EXPECT WS-DORM-HV.HV-DORM-CUTOFF-DATE TO BE "1982-10-10"
    EXPECT WS-PARM-RECORD.WS-PARM-ESCH-YEARS TO BE 46
