TESTSUITE "STMTGEN"

TESTCASE "2100-FETCH-ACCOUNT: WHEN OTHER"
    MOCK OPEN STMTOUT
    END-MOCK
    MOCK OPEN STMTRPT
    END-MOCK
    MOCK SQL "SELECT"
        MOVE "DOROTHY" TO HV-FIRST-NAME
        MOVE "MILLER" TO HV-LAST-NAME
        MOVE "B5BD5I13OBR0S70NKKN8AM8S1MNGT544" TO HV-ADDR1
        MOVE "KP5UO0L17X5YER82MB0E46IVOLE2AYXC" TO HV-ADDR2
        MOVE "LOS ANGELES" TO HV-CITY
        MOVE "IL" TO HV-STATE
        MOVE "82520" TO HV-ZIP
        MOVE "5JGCKH5O8V" TO HV-CIF-NUMBER
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK CALL "STMTFMT"
    END-MOCK
    MOCK SQL "OPEN STMT_TRAN_CUR"
    END-MOCK
    MOCK SQL "FETCH STMT_TRAN_CUR"
        MOVE "HV0000000000001" TO HV-TRAN-ID
        MOVE "XX" TO HV-TRAN-TYPE
        MOVE "BVFF" TO HV-TRAN-CODE
        MOVE -270240.59 TO HV-TRAN-AMOUNT
        MOVE "1972-08-25" TO HV-TRAN-DATE
        MOVE "1995-12-20" TO HV-POST-DATE
        MOVE "DELTA LIMA CHARLIE" TO HV-TRAN-DESC
        MOVE "LW0WFMX915" TO HV-CHECK-NUM
        MOVE 387846.39 TO HV-RUN-BAL
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE STMT_ACCT_CUR"
    END-MOCK
    MOCK CLOSE STMTOUT
    END-MOCK
    MOCK CLOSE STMTRPT
    END-MOCK
    MOCK SQL "OPEN STMT_ACCT_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH STMT_ACCT_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE STMT-OUTPUT-RECORD
    END-MOCK
    MOCK SQL "CLOSE STMT_TRAN_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN STMTOUT WAS CALLED 1 TIMES
    VERIFY OPEN STMTRPT WAS CALLED 1 TIMES
    VERIFY SQL "SELECT" WAS CALLED 1 TIMES
    VERIFY CALL "STMTFMT" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-STMT-FMT-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY SQL "OPEN STMT_TRAN_CUR" WAS CALLED 1 TIMES
    VERIFY CALL "STMTFMT" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-STMT-FMT-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY SQL "FETCH STMT_TRAN_CUR" WAS CALLED 1 TIMES
    VERIFY CALL "STMTFMT" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-STMT-FMT-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY CALL "STMTFMT" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-STMT-FMT-PARMS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=caller-dataflow)
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE STMT_ACCT_CUR" WAS CALLED 1 TIMES
    VERIFY CLOSE STMTOUT WAS CALLED 1 TIMES
    VERIFY CLOSE STMTRPT WAS CALLED 1 TIMES

