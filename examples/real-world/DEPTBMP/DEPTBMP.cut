TESTSUITE "DEPTBMP deposit batch (IMS BMP)"

*> 0000-MAIN-PROCESS ends in GOBACK, a program terminator -- most cases
*> here still target a sub-paragraph directly for finer-grained control
*> (same pattern ACCTPRG/DEPTIMSM use), but GOBACK reached through a
*> plain PERFORM chain is neutralized rather than killing the test
*> binary, so one case below exercises 0000-MAIN-PROCESS directly, its
*> real entry point.
*>
*> CUST-STATUS lives in CUST-PCB-LNK, originally LINKAGE SECTION storage
*> bound only through the separate ENTRY 'DLITCBL' -- mockymock's driver
*> never binds it. The engine neutralizes it into real WORKING-STORAGE
*> automatically; a MOCK CALL "CBLTDLI" body can set CUST-STATUS exactly
*> like any other mocked CALL's output.
*>
*> DEPTBMP's DL/I CHKP calls (1000-INITIALIZE's initial checkpoint and
*> 2500-CHECKPOINT's periodic one) never inspect CUST-STATUS afterward --
*> unlike the GU/ISRT calls -- so their mock bodies still set it to
*> spaces for realism even though nothing in the program reads it back.

TESTCASE "1000-INITIALIZE opens files, registers the initial IMS checkpoint, and reads the first record"
    MOCK OPEN DEPTIN
    END-MOCK
    MOCK OPEN DEPTRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    *> Mocking the whole READ removes its AT END clause body too (the
    *> SET WS-EOF TO TRUE it held is spliced out along with it), so a
    *> success case must not touch WS-EOF-FLAG -- it stays "N" from its
    *> own VALUE clause -- and must set the FILE SECTION record fields
    *> directly since no real disk read happens.
    MOCK READ DEPTIN
        MOVE "1000000001" TO BATCH-CIF-NUMBER
        MOVE "100000000012" TO BATCH-ACCT-NUMBER
        MOVE "150.00" TO BATCH-AMOUNT-CHAR
        MOVE "DP" TO BATCH-TRAN-TYPE
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-CHKP-SEQ TO BE 1
    EXPECT WS-EOF-FLAG TO BE "N"
    EXPECT BATCH-CIF-NUMBER TO BE "1000000001"
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE
    VERIFY READ DEPTIN WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "1000-INITIALIZE flags EOF when DEPTIN has no records"
    MOCK OPEN DEPTIN
    END-MOCK
    MOCK OPEN DEPTRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    MOCK READ DEPTIN
        SET WS-EOF TO TRUE
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-EOF-FLAG TO BE "Y"
    EXPECT WS-CHKP-SEQ TO BE 1
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2100-VALIDATE-RECORD rejects a blank CIF number"
    MOVE SPACES TO BATCH-CIF-NUMBER
    MOVE "123456789012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "150.00" TO BATCH-AMOUNT-CHAR
    PERFORM 2100-VALIDATE-RECORD
    EXPECT WS-DET-STATUS TO BE "CIF REQUIRED"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-INVALID-INPUT TO BE 1

TESTCASE "2100-VALIDATE-RECORD rejects an invalid transaction type"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "XX" TO BATCH-TRAN-TYPE
    MOVE "150.00" TO BATCH-AMOUNT-CHAR
    PERFORM 2100-VALIDATE-RECORD
    EXPECT WS-DET-STATUS TO BE "BAD TRAN TYP"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-INVALID-INPUT TO BE 1

TESTCASE "2100-VALIDATE-RECORD rejects a non-numeric amount"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "NOTANUMBER" TO BATCH-AMOUNT-CHAR
    PERFORM 2100-VALIDATE-RECORD
    EXPECT WS-DET-STATUS TO BE "BAD AMOUNT  "
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-INVALID-INPUT TO BE 1

TESTCASE "2100-VALIDATE-RECORD rejects a non-positive amount"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "0" TO BATCH-AMOUNT-CHAR
    PERFORM 2100-VALIDATE-RECORD
    EXPECT WS-DET-STATUS TO BE "AMOUNT LE ZE"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-INVALID-INPUT TO BE 1

TESTCASE "2100-VALIDATE-RECORD accepts a valid deposit record"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "150.00" TO BATCH-AMOUNT-CHAR
    PERFORM 2100-VALIDATE-RECORD
    EXPECT WS-RECORD-ERROR TO BE "N"
    EXPECT WS-AMOUNT-WORK TO BE 150.00
    EXPECT WS-INVALID-INPUT TO BE 0

TESTCASE "2200-GET-CUSTOMER succeeds when CUSTDB reports success"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    PERFORM 2200-GET-CUSTOMER
    EXPECT WS-RECORD-ERROR TO BE "N"
    EXPECT WS-CUST-NOT-FOUND TO BE 0
    EXPECT WS-DB-ERRORS TO BE 0
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2200-GET-CUSTOMER flags an error when the customer is not found"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOCK CALL "CBLTDLI"
        MOVE "GE" TO CUST-STATUS
    END-MOCK
    PERFORM 2200-GET-CUSTOMER
    EXPECT WS-DET-STATUS TO BE "CUST NOT FOU"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-CUST-NOT-FOUND TO BE 1
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2200-GET-CUSTOMER flags a database error on an unexpected CUSTDB status"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOCK CALL "CBLTDLI"
        MOVE "AB" TO CUST-STATUS
    END-MOCK
    PERFORM 2200-GET-CUSTOMER
    EXPECT WS-DET-STATUS TO BE "DB ERROR CUS"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-DB-ERRORS TO BE 1
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2300-INSERT-TRNSEG posts a deposit when CUSTDB accepts the insert"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE 150.00 TO WS-AMOUNT-WORK
    MOVE "2026-08-08" TO WS-BUSINESS-DATE
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    PERFORM 2300-INSERT-TRNSEG
    EXPECT WS-DET-STATUS TO BE "POSTED      "
    EXPECT WS-TRNS-INSERTED TO BE 1
    EXPECT TRAN-CIF-NUMBER TO BE "1000000001"
    EXPECT TRAN-ACCT-NUMBER TO BE "100000000012"
    EXPECT TRAN-AMOUNT TO BE 150.00
    EXPECT TRAN-TYPE TO BE "DP"
    EXPECT TRAN-CHANNEL TO BE "BATC"
    EXPECT TRAN-STATUS TO BE "P"
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2300-INSERT-TRNSEG flags a database error when CUSTDB rejects the insert"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE 150.00 TO WS-AMOUNT-WORK
    MOVE "2026-08-08" TO WS-BUSINESS-DATE
    MOCK CALL "CBLTDLI"
        MOVE "AB" TO CUST-STATUS
    END-MOCK
    PERFORM 2300-INSERT-TRNSEG
    EXPECT WS-DET-STATUS TO BE "DB ERROR ISR"
    EXPECT WS-RECORD-ERROR TO BE "Y"
    EXPECT WS-DB-ERRORS TO BE 1
    EXPECT WS-TRNS-INSERTED TO BE 0
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2400-WRITE-DETAIL writes a formatted detail line for a posted deposit"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE 150.00 TO WS-AMOUNT-WORK
    MOCK WRITE RPT-RECORD
    END-MOCK
    PERFORM 2400-WRITE-DETAIL
    EXPECT WS-DET-CIF TO BE "1000000001"
    EXPECT WS-DET-ACCT TO BE "100000000012"
    EXPECT WS-DET-TYPE TO BE "DP"
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "2500-CHECKPOINT issues a CBLTDLI CHKP call once the frequency threshold is reached"
    MOVE 499 TO WS-CHKP-COUNT
    MOVE 5 TO WS-CHKP-SEQ
    MOVE 100 TO WS-RECS-READ
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    PERFORM 2500-CHECKPOINT
    EXPECT WS-CHKP-COUNT TO BE 0
    EXPECT WS-CHKP-SEQ TO BE 6
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2500-CHECKPOINT skips the CBLTDLI CHKP call below the frequency threshold"
    MOVE 0 TO WS-CHKP-COUNT
    MOVE 5 TO WS-CHKP-SEQ
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    PERFORM 2500-CHECKPOINT
    EXPECT WS-CHKP-COUNT TO BE 1
    EXPECT WS-CHKP-SEQ TO BE 5
    VERIFY CALL "CBLTDLI" WAS CALLED NEVER

TESTCASE "2000-PROCESS-DEPOSITS posts a valid deposit end-to-end"
    MOVE "1000000001" TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "150.00" TO BATCH-AMOUNT-CHAR
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    *> The paragraph's own trailing READ DEPTIN (priming the next loop
    *> iteration) also needs a mock -- it is statically reachable even
    *> though this test only exercises one call through it.
    MOCK READ DEPTIN
        SET WS-EOF TO TRUE
    END-MOCK
    PERFORM 2000-PROCESS-DEPOSITS
    EXPECT WS-RECS-READ TO BE 1
    EXPECT WS-TRNS-INSERTED TO BE 1
    EXPECT WS-DET-STATUS TO BE "POSTED      "
    *> One CBLTDLI call for the GU in 2200-GET-CUSTOMER, one for the ISRT
    *> in 2300-INSERT-TRNSEG -- 2500-CHECKPOINT's own CALL never fires
    *> because WS-CHKP-COUNT (0 by default) stays below WS-CHKP-FREQ (500)
    *> after a single record.
    VERIFY CALL "CBLTDLI" WAS CALLED 2 TIMES
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE
    VERIFY READ DEPTIN WAS CALLED ONCE

TESTCASE "2000-PROCESS-DEPOSITS skips CUSTDB calls for an invalid record"
    MOVE SPACES TO BATCH-CIF-NUMBER
    MOVE "100000000012" TO BATCH-ACCT-NUMBER
    MOVE "DP" TO BATCH-TRAN-TYPE
    MOVE "150.00" TO BATCH-AMOUNT-CHAR
    *> 2200-GET-CUSTOMER/2300-INSERT-TRNSEG are statically reachable from
    *> this paragraph (guarded by IF RECORD-OK), so CBLTDLI still needs a
    *> mock even though the blank-CIF validation failure means neither
    *> paragraph's CALL actually executes at runtime.
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK READ DEPTIN
        SET WS-EOF TO TRUE
    END-MOCK
    PERFORM 2000-PROCESS-DEPOSITS
    EXPECT WS-INVALID-INPUT TO BE 1
    EXPECT WS-DET-STATUS TO BE "CIF REQUIRED"
    EXPECT WS-TRNS-INSERTED TO BE 0
    VERIFY CALL "CBLTDLI" WAS CALLED NEVER
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE
    VERIFY READ DEPTIN WAS CALLED ONCE

TESTCASE "3000-FINALIZE reports a clean return code when no errors occurred"
    MOVE 0 TO WS-DB-ERRORS
    MOVE 0 TO WS-INVALID-INPUT
    MOCK CLOSE DEPTIN
    END-MOCK
    MOCK CLOSE DEPTRPT
    END-MOCK
    PERFORM 3000-FINALIZE
    EXPECT RETURN-CODE TO BE 0
    VERIFY CLOSE DEPTIN WAS CALLED ONCE
    VERIFY CLOSE DEPTRPT WAS CALLED ONCE

TESTCASE "3000-FINALIZE reports a non-zero return code when database errors occurred"
    MOVE 1 TO WS-DB-ERRORS
    MOVE 0 TO WS-INVALID-INPUT
    MOCK CLOSE DEPTIN
    END-MOCK
    MOCK CLOSE DEPTRPT
    END-MOCK
    PERFORM 3000-FINALIZE
    EXPECT RETURN-CODE TO BE 4

TESTCASE "0000-MAIN-PROCESS runs one deposit end-to-end via its real entry point"
    *> GOBACK is reached via a plain PERFORM chain (1000-INITIALIZE,
    *> 2000-PROCESS-DEPOSITS, 3000-FINALIZE), neutralized instead of
    *> killing the suite. The DEPTIN READ tally drives one record through
    *> the loop, then end-of-file on the second call; every CBLTDLI call
    *> (the initial CHKP, the GU, and the ISRT) succeeds uniformly.
    MOCK OPEN DEPTIN
    END-MOCK
    MOCK OPEN DEPTRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CUST-STATUS
    END-MOCK
    MOCK READ DEPTIN
        EVALUATE UT-READ-DEPTIN-TALLY
            WHEN 1
                MOVE "1000000001" TO BATCH-CIF-NUMBER
                MOVE "100000000012" TO BATCH-ACCT-NUMBER
                MOVE "150.00" TO BATCH-AMOUNT-CHAR
                MOVE "DP" TO BATCH-TRAN-TYPE
            WHEN 2
                SET WS-EOF TO TRUE
        END-EVALUATE
    END-MOCK
    MOCK CLOSE DEPTIN
    END-MOCK
    MOCK CLOSE DEPTRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-RECS-READ TO BE 1
    EXPECT WS-TRNS-INSERTED TO BE 1
    EXPECT WS-EOF-FLAG TO BE "Y"
    EXPECT RETURN-CODE TO BE 0
    *> One CHKP (1000-INITIALIZE) + one GU (2200-GET-CUSTOMER) + one ISRT
    *> (2300-INSERT-TRNSEG) for the single record processed.
    VERIFY CALL "CBLTDLI" WAS CALLED 3 TIMES
    VERIFY READ DEPTIN WAS CALLED 2 TIMES
    VERIFY WRITE RPT-RECORD WAS CALLED 2 TIMES
