                MOVE "WS00000000000000009" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 10
                MOVE "WS00000000000000010" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
        END-EVALUATE
    END-MOCK
