TESTSUITE "ACHPROC"

TESTCASE "2000-PROCESS-ACH-FILE: WHEN AED-RECORD-TYPE = 1"
    MOCK OPEN ACHFILE
    END-MOCK
    MOCK OPEN ACHRETURN
    END-MOCK
    MOCK OPEN ACHRPT
    END-MOCK
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK READ PARMFILE
        EVALUATE TRUE
            WHEN UT-READ-PARMFILE-TALLY = 1
                MOVE "WS00000000000000001" TO WS-PARM-FILE-ID
                MOVE "I" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 2
                MOVE "WS00000000000000002" TO WS-PARM-FILE-ID
                MOVE "I" TO WS-PARM-DIRECTION
