    VERIFY CLOSE PARMFILE WAS CALLED 1 TIMES

TESTCASE "2000-PROCESS-ACH-FILE: WHEN AED-RECORD-TYPE = 6"
    MOCK OPEN ACHFILE
    END-MOCK
    MOCK OPEN ACHRETURN
    END-MOCK
    MOCK OPEN ACHRPT
    END-MOCK
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK READ PARMFILE
        EVALUATE TRUE
            WHEN UT-READ-PARMFILE-TALLY = 1
                MOVE "WS00000000000000001" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 2
                MOVE "WS00000000000000002" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 3
                MOVE "WS00000000000000003" TO WS-PARM-FILE-ID
                MOVE "I" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 4
                MOVE "WS00000000000000004" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 5
                MOVE "WS00000000000000005" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 6
                MOVE "WS00000000000000006" TO WS-PARM-FILE-ID
                MOVE "I" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 7
                MOVE "WS00000000000000007" TO WS-PARM-FILE-ID
                MOVE "I" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 8
                MOVE "WS00000000000000008" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 9
                MOVE "WS00000000000000009" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
            WHEN UT-READ-PARMFILE-TALLY = 10
                MOVE "WS00000000000000010" TO WS-PARM-FILE-ID
                MOVE "O" TO WS-PARM-DIRECTION
        END-EVALUATE
    END-MOCK
    MOCK READ ACHFILE
        EVALUATE TRUE
            WHEN UT-READ-ACHFILE-TALLY = 1
                MOVE "1" TO AFH-RECORD-TYPE
