TESTSUITE "LOANPMT"

TESTCASE "2100-FETCH-LOAN: WHEN OTHER"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "7GRLKNP4O6YY" TO HV-LOAN-NUMBER
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "K74DDAT0LX" TO HV-CIF-NUMBER
        MOVE "WPIF" TO HV-LOAN-TYPE
        MOVE "E" TO HV-LOAN-STATUS
        MOVE 919128.63 TO HV-CURRENT-BALANCE
        MOVE 42.682962 TO HV-INTEREST-RATE
        MOVE 750644.96 TO HV-PAYMENT-AMOUNT
        MOVE "2006-02-02" TO HV-NEXT-DUE-DATE
        MOVE "MARTINEZ" TO HV-LAST-PMT-DATE
        MOVE -4992 TO HV-DAYS-PAST-DUE
        MOVE -743387.75 TO HV-LATE-FEE
        MOVE "X" TO HV-LATE-FEE-ASSESSED
        MOVE 9474941.50 TO HV-ESCROW-PMT
        MOVE -136983311.85 TO HV-INTEREST-ACCRUED
        MOVE 2510518459019.02 TO HV-PRINCIPAL-PAID
        MOVE 4989042030627.42 TO HV-INT-YTD
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE "GU  " TO DLI-GU
        MOVE "PATRICIA" TO CPCB-DBD-NAME
        MOVE "MB" TO CPCB-SEG-LEVEL
        MOVE "II" TO CPCB-STATUS-CODE
        MOVE "KW4V" TO CPCB-PROC-OPTIONS
        MOVE 40629 TO CPCB-RESERVED
        MOVE "ROBERT A" TO CPCB-SEG-NAME
        MOVE 34175 TO CPCB-KEY-LENGTH
        MOVE 276 TO CPCB-NUM-SENS-SEGS
        MOVE "CPC000000000000000000000000001" TO CPCB-KEY-FEEDBACK
        MOVE "8L1C33WT3TXNOPN84M7KXBRM4HVUGV4N" TO WS-IMS-CUST-AREA
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN PMTFILE WAS CALLED 1 TIMES
    VERIFY OPEN LOANRPT WAS CALLED 1 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-INT-PARMS -- value supplied by the program under test, not mock-generated (provenance=caller-dataflow)
    VERIFY CALL "CBLTDLI" WAS CALLED 1 TIMES
    *> STUB EXPECT DLI-GU -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=assumed-bidirectional)
    *> STUB EXPECT CUSTOMER-PCB-MASK -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=assumed-bidirectional)
    *> STUB EXPECT WS-IMS-CUST-AREA -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=assumed-bidirectional)
    *> STUB EXPECT SSA-CUSTOMER -- value supplied by the program under test, not mock-generated (provenance=caller-dataflow)
    VERIFY SQL "ROLLBACK" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE PMTFILE WAS CALLED 1 TIMES
    VERIFY CLOSE LOANRPT WAS CALLED 1 TIMES

