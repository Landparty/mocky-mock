TESTSUITE "LOANPMT"

*> LOANPMT is the daily loan-payment posting batch. It opens a
*> FOR-UPDATE cursor over every active loan due today or past due,
*> and for each row: calls the INTRATE assembler for a 30/360 days
*> interest amount, splits the payment into interest/principal,
*> calls IMS (CBLTDLI GU) for a customer-segment audit read, posts a
*> 'LPM' transaction-history row, conditionally assesses a $25 late
*> fee (tran code 'FEE'), and updates BANK.LOAN under the cursor.
*> These cases exercise: the cursor-open abort, a clean payment
*> split with no fee, the INTRATE assembler failure fallback, the
*> FETCH "OTHER" fatal-error halt, an empty due-today day, and a
*> failed UPDATE that rolls back but still counts as a loan error.
*>
*> They also pin a real ordering bug found while reading the source:
*> 2300-APPLY-PAYMENT unconditionally resets HV-DAYS-PAST-DUE to
*> ZERO *before* 2400-CHECK-LATE-FEE ever checks
*> "HV-DAYS-PAST-DUE > 15" -- so in an actual run the late-fee branch
*> can never fire, no matter how delinquent the loan was at FETCH
*> time. 2400-CHECK-LATE-FEE's own logic is correct in isolation
*> (see the two isolated cases below), so two complementary things
*> are asserted: the paragraph's own branch logic works when entered
*> directly, and the full loan loop never actually reaches it because
*> of the reset-before-check ordering. Not fixed here -- it's a
*> business-logic defect, not the compile-blocking syntax bug this
*> task is scoped to repair.

*> 1000-INITIALIZE: if LOAN_CURSOR fails to open, the program must
*> abort immediately with RETURN-CODE 16 and never reach the fetch
*> loop at all.
TESTCASE "1000-INITIALIZE: LOAN_CURSOR open failure aborts the run with return code 16"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE -923 TO SQLCODE
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT RETURN-CODE TO BE 16
    VERIFY OPEN PMTFILE WAS CALLED ONCE
    VERIFY OPEN LOANRPT WAS CALLED ONCE
    VERIFY SQL "OPEN" WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

*> Happy path: an on-time loan (0 days past due, no fee yet assessed)
*> gets its payment split by the (mocked) INTRATE interest amount,
*> the DB2/IMS/report side effects all fire exactly once, and no late
*> fee is ever touched.
TESTCASE "2000-PROCESS-LOANS: a regular on-time payment splits principal and interest with no late fee"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-LOAN-NUMBER = "LN0000010023", HV-ACCT-NUMBER = "AC0000455012", HV-CIF-NUMBER = "CIF0012345", HV-LOAN-TYPE = "MORT", HV-LOAN-STATUS = "A", HV-CURRENT-BALANCE = 95000.00, HV-INTEREST-RATE = 6.000000, HV-PAYMENT-AMOUNT = 1200.00, HV-NEXT-DUE-DATE = "2026-08-01", HV-LAST-PMT-DATE = "2026-07-01", HV-DAYS-PAST-DUE = 0, HV-LATE-FEE = 0.00, HV-LATE-FEE-ASSESSED = "N", HV-ESCROW-PMT = 150.00, HV-INTEREST-ACCRUED = 475.00, HV-PRINCIPAL-PAID = 8000.00, HV-INT-YTD = 5000.00 )
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
        MOVE 475.00 TO IP-INTEREST-AMT
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
        MOVE "CUSTDB01" TO CPCB-DBD-NAME
        MOVE "01" TO CPCB-SEG-LEVEL
        MOVE "CUSTSEG " TO CPCB-SEG-NAME
        MOVE 10 TO CPCB-KEY-LENGTH
        MOVE 1 TO CPCB-NUM-SENS-SEGS
        MOVE "SMITH JOHN Q  ACTIVE  " TO WS-IMS-CUST-AREA
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-INTEREST-PORTION TO BE 475.00
    EXPECT WS-PRINCIPAL-PORTION TO BE 725.00
    EXPECT HV-CURRENT-BALANCE TO BE 94275.00
    EXPECT HV-PRINCIPAL-PAID TO BE 8725.00
    EXPECT HV-INT-YTD TO BE 5475.00
    EXPECT HV-LATE-FEE-ASSESSED TO BE "N"
    EXPECT WS-LATE-FEES TO BE 0
    EXPECT WS-LOANS-PROCESSED TO BE 1
    EXPECT WS-PMTS-APPLIED TO BE 1
    EXPECT WS-LOAN-ERRORS TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS PERFORMED 2 TIMES
    VERIFY CALL "INTRATE" WAS CALLED ONCE
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM" WAS CALLED ONCE
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE" WAS CALLED NEVER
    VERIFY SQL "UPDATE" WAS CALLED ONCE
    VERIFY SQL "ROLLBACK" WAS CALLED NEVER
    VERIFY SQL "COMMIT" WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED 2 TIMES

*> Bug-pinning integration case: the loan is 20 days past due (well
*> over the 15-day threshold) and has not yet had a fee assessed --
*> by the source comment's own intent this should charge a $25 late
*> fee -- but 2300-APPLY-PAYMENT's unconditional
*> "MOVE ZERO TO HV-DAYS-PAST-DUE" runs first and wipes out the value
*> 2400-CHECK-LATE-FEE is about to test, so the fee never posts. This
*> pins the real, current behavior of the full loop (see the two
*> isolated 2400-CHECK-LATE-FEE cases below for proof the paragraph's
*> own AND condition is otherwise correct).
TESTCASE "2000-PROCESS-LOANS: a past-due loan's late fee never posts because 2300-APPLY-PAYMENT resets DAYS-PAST-DUE first"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-LOAN-NUMBER = "LN0000010045", HV-ACCT-NUMBER = "AC0000455034", HV-CIF-NUMBER = "CIF0012399", HV-LOAN-TYPE = "AUTO", HV-LOAN-STATUS = "A", HV-CURRENT-BALANCE = 95000.00, HV-INTEREST-RATE = 6.000000, HV-PAYMENT-AMOUNT = 1200.00, HV-NEXT-DUE-DATE = "2026-06-15", HV-LAST-PMT-DATE = "2026-05-15", HV-DAYS-PAST-DUE = 20, HV-LATE-FEE = 0.00, HV-LATE-FEE-ASSESSED = "N", HV-ESCROW-PMT = 150.00, HV-INTEREST-ACCRUED = 475.00, HV-PRINCIPAL-PAID = 8000.00, HV-INT-YTD = 5000.00 )
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
        MOVE 475.00 TO IP-INTEREST-AMT
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
        MOVE "CUSTDB01" TO CPCB-DBD-NAME
        MOVE "01" TO CPCB-SEG-LEVEL
        MOVE "CUSTSEG " TO CPCB-SEG-NAME
        MOVE 10 TO CPCB-KEY-LENGTH
        MOVE 1 TO CPCB-NUM-SENS-SEGS
        MOVE "JONES MARY   ACTIVE  " TO WS-IMS-CUST-AREA
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-CURRENT-BALANCE TO BE 94275.00
    EXPECT HV-LATE-FEE-ASSESSED TO BE "N"
    EXPECT WS-LATE-FEES TO BE 0
    EXPECT WS-LOAN-ERRORS TO BE 0
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE" WAS CALLED NEVER
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM" WAS CALLED ONCE

*> Isolated proof that 2400-CHECK-LATE-FEE's own AND condition is
*> correct: entered directly (bypassing 2300's reset), a loan that IS
*> over 15 days past due and not yet assessed gets the $25 fee added
*> to its balance, the flag flipped, and a 'FEE' transaction posted.
TESTCASE "2400-CHECK-LATE-FEE (isolated): a fee-eligible loan is assessed a $25 late fee"
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOVE 20 TO HV-DAYS-PAST-DUE
    MOVE "N" TO HV-LATE-FEE-ASSESSED
    MOVE 79433.33 TO HV-CURRENT-BALANCE
    MOVE "AC0000455099" TO HV-ACCT-NUMBER
    PERFORM 2400-CHECK-LATE-FEE
    EXPECT HV-LATE-FEE-ASSESSED TO BE "Y"
    EXPECT HV-LATE-FEE TO BE 25.00
    EXPECT HV-CURRENT-BALANCE TO BE 79458.33
    EXPECT WS-LATE-FEES TO BE 1
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE" WAS CALLED ONCE

*> Isolated proof of the AND's other leg: a loan that is past due but
*> already has LATE-FEE-ASSESSED = 'Y' must not be double-charged.
TESTCASE "2400-CHECK-LATE-FEE (isolated): a fee already assessed is not double-charged"
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOVE 45 TO HV-DAYS-PAST-DUE
    MOVE "Y" TO HV-LATE-FEE-ASSESSED
    MOVE 44633.75 TO HV-CURRENT-BALANCE
    MOVE "AC0000455101" TO HV-ACCT-NUMBER
    PERFORM 2400-CHECK-LATE-FEE
    EXPECT HV-LATE-FEE-ASSESSED TO BE "Y"
    EXPECT HV-CURRENT-BALANCE TO BE 44633.75
    EXPECT WS-LATE-FEES TO BE 0
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE" WAS CALLED NEVER

*> Error path: the INTRATE assembler subprogram comes back with a
*> non-zero return code. 2200-CALC-INTEREST-PORTION's fallback must
*> treat the whole payment as principal, book zero interest, and
*> count a loan error -- proves the ELSE-less IF's error leg, not
*> just that INTRATE is statically reachable.
TESTCASE "2200-CALC-INTEREST-PORTION: INTRATE failure falls back to full payment as principal"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-LOAN-NUMBER = "LN0000010067", HV-ACCT-NUMBER = "AC0000455056", HV-CIF-NUMBER = "CIF0012410", HV-LOAN-TYPE = "PERS", HV-LOAN-STATUS = "A", HV-CURRENT-BALANCE = 60000.00, HV-INTEREST-RATE = 7.250000, HV-PAYMENT-AMOUNT = 900.00, HV-NEXT-DUE-DATE = "2026-08-01", HV-LAST-PMT-DATE = "2026-07-01", HV-DAYS-PAST-DUE = 0, HV-LATE-FEE = 0.00, HV-LATE-FEE-ASSESSED = "N", HV-ESCROW-PMT = 0.00, HV-INTEREST-ACCRUED = 362.50, HV-PRINCIPAL-PAID = 2000.00, HV-INT-YTD = 1500.00 )
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 12 TO RETURN-CODE
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
        MOVE "CUSTDB01" TO CPCB-DBD-NAME
        MOVE "01" TO CPCB-SEG-LEVEL
        MOVE "CUSTSEG " TO CPCB-SEG-NAME
        MOVE 10 TO CPCB-KEY-LENGTH
        MOVE 1 TO CPCB-NUM-SENS-SEGS
        MOVE "DAVIS ROBERT  ACTIVE " TO WS-IMS-CUST-AREA
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-INTEREST-PORTION TO BE 0.00
    EXPECT WS-PRINCIPAL-PORTION TO BE 900.00
    EXPECT HV-CURRENT-BALANCE TO BE 59100.00
    EXPECT WS-LOAN-ERRORS TO BE 1
    EXPECT RETURN-CODE TO BE 4
    VERIFY CALL "INTRATE" WAS CALLED ONCE
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM" WAS CALLED ONCE

*> Error path: the cursor FETCH itself fails (not "no more rows") on
*> the very first fetch. The program must set FATAL-ERROR-FOUND, halt
*> the loop immediately, and never reach any of the per-loan paragraphs.
TESTCASE "2100-FETCH-LOAN: WHEN OTHER sets fatal error and stops the loan loop"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH"
        MOVE -904 TO SQLCODE
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
        MOVE 0.00 TO IP-INTEREST-AMT
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-LOANS-PROCESSED TO BE 0
    EXPECT WS-LOAN-ERRORS TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS CALLED ONCE
    VERIFY CALL "INTRATE" WAS CALLED NEVER
    VERIFY CALL "CBLTDLI" WAS CALLED NEVER
    VERIFY SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM" WAS CALLED NEVER
    VERIFY SQL "UPDATE" WAS CALLED NEVER
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

*> Empty business day: the cursor returns no rows at all (SQLCODE 100
*> on the very first fetch). Nothing should be processed, and the
*> program should still complete cleanly with RETURN-CODE 0.
TESTCASE "2000-PROCESS-LOANS: no loans due today processes nothing"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH"
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
        MOVE 0.00 TO IP-INTEREST-AMT
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-LOANS-PROCESSED TO BE 0
    EXPECT WS-PMTS-APPLIED TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS CALLED ONCE
    VERIFY CALL "INTRATE" WAS CALLED NEVER
    VERIFY SQL "UPDATE" WAS CALLED NEVER
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

*> Error path: BANK.LOAN's UPDATE fails under the cursor (e.g. a
*> deadlock). The program must roll back, count a loan error, and
*> still write the report detail line and commit at finalize --
*> proves the IF/ELSE around SQLCODE after the UPDATE, and that a
*> per-loan DB failure doesn't abort the batch. The in-memory host
*> variables (already updated before the failed UPDATE) are NOT
*> reverted by the ROLLBACK -- only the DB row is -- so the report
*> line still reflects the computed new balance.
TESTCASE "2500-UPDATE-LOAN-RECORD: update failure rolls back and flags a loan error"
    MOCK OPEN PMTFILE
    END-MOCK
    MOCK OPEN LOANRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-LOAN-NUMBER = "LN0000010089", HV-ACCT-NUMBER = "AC0000455078", HV-CIF-NUMBER = "CIF0012455", HV-LOAN-TYPE = "HELC", HV-LOAN-STATUS = "A", HV-CURRENT-BALANCE = 30000.00, HV-INTEREST-RATE = 8.000000, HV-PAYMENT-AMOUNT = 500.00, HV-NEXT-DUE-DATE = "2026-08-01", HV-LAST-PMT-DATE = "2026-07-01", HV-DAYS-PAST-DUE = 0, HV-LATE-FEE = 0.00, HV-LATE-FEE-ASSESSED = "N", HV-ESCROW-PMT = 0.00, HV-INTEREST-ACCRUED = 200.00, HV-PRINCIPAL-PAID = 1500.00, HV-INT-YTD = 900.00 )
    END-MOCK
    MOCK CALL "INTRATE"
        MOVE 0 TO RETURN-CODE
        MOVE 200.00 TO IP-INTEREST-AMT
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO CPCB-STATUS-CODE
        MOVE "CUSTDB01" TO CPCB-DBD-NAME
        MOVE "01" TO CPCB-SEG-LEVEL
        MOVE "CUSTSEG " TO CPCB-SEG-NAME
        MOVE 10 TO CPCB-KEY-LENGTH
        MOVE 1 TO CPCB-NUM-SENS-SEGS
        MOVE "WILSON ANNE   ACTIVE " TO WS-IMS-CUST-AREA
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, LPM"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT INTO BANK. TRANSACTION_HIST ( TRAN_ID, ACCT_NUMBER, TRAN_TYPE, TRAN_CODE, AMOUNT, EFFECTIVE_DATE, POST_DATE, DESCRIPTION, CHANNEL, TRAN_STATUS ) VALUES (:HV-TRAN-ID,:HV-ACCT-NUMBER, DR, FEE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE -911 TO SQLCODE
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE PMTFILE
    END-MOCK
    MOCK CLOSE LOANRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-LOAN-ERRORS TO BE 1
    EXPECT HV-CURRENT-BALANCE TO BE 29700.00
    EXPECT RETURN-CODE TO BE 4
    VERIFY SQL "UPDATE" WAS CALLED ONCE
    VERIFY SQL "ROLLBACK" WAS CALLED ONCE
    VERIFY SQL "COMMIT" WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED 2 TIMES
