TESTSUITE "ACCTMNT"

TESTCASE "2000-PROCESS-PARM-CARDS: WHEN PARM-RATE-CHG"
    MOCK OPEN PARMFILE
    END-MOCK
    MOCK OPEN ACCTMRPT
    END-MOCK
    MOCK READ PARMFILE
        EVALUATE TRUE
            WHEN UT-READ-PARMFILE-TALLY = 1
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "IXY" TO WS-PARM-ACCT-TYPE
                MOVE 73.074293 TO WS-PARM-NEW-RATE
                MOVE 4214 TO WS-PARM-DORM-DAYS
                MOVE "WS00001" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 2
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "ODD" TO WS-PARM-ACCT-TYPE
                MOVE 86.052742 TO WS-PARM-NEW-RATE
                MOVE 6576 TO WS-PARM-DORM-DAYS
                MOVE "WS00002" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 3
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "CEN" TO WS-PARM-ACCT-TYPE
                MOVE 71.423467 TO WS-PARM-NEW-RATE
                MOVE 8030 TO WS-PARM-DORM-DAYS
                MOVE "WS00003" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 4
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "QUA" TO WS-PARM-ACCT-TYPE
                MOVE 56.038030 TO WS-PARM-NEW-RATE
                MOVE 6947 TO WS-PARM-DORM-DAYS
                MOVE "WS00004" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 5
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "NDG" TO WS-PARM-ACCT-TYPE
                MOVE 45.392431 TO WS-PARM-NEW-RATE
                MOVE 8996 TO WS-PARM-DORM-DAYS
                MOVE "WS00005" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 6
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "MGN" TO WS-PARM-ACCT-TYPE
                MOVE 89.437246 TO WS-PARM-NEW-RATE
                MOVE 9823 TO WS-PARM-DORM-DAYS
                MOVE "WS00006" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 7
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "FCH" TO WS-PARM-ACCT-TYPE
                MOVE 67.207298 TO WS-PARM-NEW-RATE
                MOVE 7089 TO WS-PARM-DORM-DAYS
                MOVE "WS00007" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 8
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "WCO" TO WS-PARM-ACCT-TYPE
                MOVE 63.220551 TO WS-PARM-NEW-RATE
                MOVE 6042 TO WS-PARM-DORM-DAYS
                MOVE "WS00008" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 9
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "UJS" TO WS-PARM-ACCT-TYPE
                MOVE 72.673618 TO WS-PARM-NEW-RATE
                MOVE 9306 TO WS-PARM-DORM-DAYS
                MOVE "WS00009" TO WS-PARM-USER-ID
            WHEN UT-READ-PARMFILE-TALLY = 10
                MOVE "RATE" TO WS-PARM-FUNC
                MOVE "PVR" TO WS-PARM-ACCT-TYPE
                MOVE 97.436174 TO WS-PARM-NEW-RATE
                MOVE 8538 TO WS-PARM-DORM-DAYS
                MOVE "WS00010" TO WS-PARM-USER-ID
            WHEN OTHER
                *> TODO: this program's AT END clause could not be auto-replicated -- add its loop-guard MOVE by hand
        END-EVALUATE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "ROLLBACK"
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "EOG" TO HV-ACCT-TYPE
        MOVE "H" TO HV-ACCT-STATUS
        MOVE "L19YTNJ13O" TO HV-CIF-NUMBER
        MOVE 19.224023 TO HV-INTEREST-RATE
        MOVE 133389.55 TO HV-CURRENT-BALANCE
        MOVE -158014.80 TO HV-AVAILABLE-BALANCE
        MOVE "LOPEZ" TO HV-LAST-ACTIVITY-DATE
        MOVE 79045.44 TO HV-MONTHLY-FEE
        MOVE 602733.09 TO HV-MIN-BALANCE
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK CLOSE PARMFILE
    END-MOCK
    MOCK CLOSE ACCTMRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET INTEREST_RATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET CURRENT_BALANCE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE BANK. ACCOUNT SET ACCT_STATUS"
        MOVE 0 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN PARMFILE WAS CALLED 1 TIMES
    VERIFY OPEN ACCTMRPT WAS CALLED 1 TIMES
    VERIFY READ PARMFILE WAS CALLED 11 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "ROLLBACK" WAS CALLED 1 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "ROLLBACK" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY CLOSE PARMFILE WAS CALLED 1 TIMES
    VERIFY CLOSE ACCTMRPT WAS CALLED 1 TIMES

