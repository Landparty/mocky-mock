TESTSUITE "GLRECON"

TESTCASE "2100-FETCH-AGGREGATE: WHEN OTHER"
    MOCK OPEN GLRPT
    END-MOCK
    MOCK OPEN GLEXCPT
    END-MOCK
    MOCK OPEN GLMAP
    END-MOCK
    MOCK SQL "OPEN GL_BAL_CUR"
    END-MOCK
    MOCK SQL "CLOSE GL_BAL_CUR"
    END-MOCK
    MOCK SQL "FETCH GL_BAL_CUR"
        MOVE "HV0000001" TO HV-GL-ACCT
        MOVE "U" TO HV-GL-TYPE
        MOVE -42769.95 TO HV-CURRENT-DEBIT-BAL
        MOVE 98351.65 TO HV-CURRENT-CREDIT-BAL
        MOVE 236627.66 TO HV-CURRENT-NET-BAL
        MOVE 26930351455340224.00 TO HV-MTD-DR
        MOVE 69439126715178368.00 TO HV-MTD-CR
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK CLOSE GLRPT
    END-MOCK
    MOCK CLOSE GLEXCPT
    END-MOCK
    MOCK CLOSE GLMAP
    END-MOCK
    MOCK WRITE GLRPT-RECORD
    END-MOCK
    MOCK SQL "OPEN GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "CLOSE GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE GLEXCPT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN GLRPT WAS CALLED 1 TIMES
    VERIFY OPEN GLEXCPT WAS CALLED 1 TIMES
    VERIFY OPEN GLMAP WAS CALLED 1 TIMES
    VERIFY SQL "OPEN GL_BAL_CUR" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE GL_BAL_CUR" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH GL_BAL_CUR" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY CLOSE GLRPT WAS CALLED 1 TIMES
    VERIFY CLOSE GLEXCPT WAS CALLED 1 TIMES
    VERIFY CLOSE GLMAP WAS CALLED 1 TIMES

TESTCASE "empty input"
