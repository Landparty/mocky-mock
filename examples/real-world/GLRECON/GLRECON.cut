        MOVE 852085.17 TO HV-CURRENT-CREDIT-BAL
        MOVE -164507.20 TO HV-CURRENT-NET-BAL
        MOVE 91331001857999600.00 TO HV-MTD-DR
        MOVE -84874347310729968.00 TO HV-MTD-CR
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK CLOSE GLRPT
    END-MOCK
    MOCK CLOSE GLEXCPT
    END-MOCK
    MOCK CLOSE GLMAP
    END-MOCK
    MOCK WRITE GLRPT-RECORD
    END-MOCK
    MOCK SQL "OPEN GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "CLOSE GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH GL_AGG_CUR"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE GLEXCPT-RECORD
