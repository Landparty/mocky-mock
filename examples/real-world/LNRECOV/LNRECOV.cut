TESTSUITE "LNRECOV loan delinquency recovery (IMS DBB batch)"

*> LNRECOV scans LOANDB (via GHN on LOANSEG) for delinquent loans (status
*> DL) that are both past the DPD-THRESHOLD control-card value and carry a
*> balance at/above the MIN-BALANCE control-card value, and marks each
*> eligible segment RC (recovery) via REPL.
*>
*> 0000-MAIN-PROCESS ends in GOBACK, a program terminator -- most cases
*> below still target a sub-paragraph directly for finer-grained control
*> (same workaround ACCTPRG/DEPTIMSM use), but GOBACK reached through a
*> plain PERFORM chain is neutralized rather than killing the test binary,
*> so one case below exercises 0000-MAIN-PROCESS directly, its real entry
*> point.
*>
*> LOAN-STATUS lives in LOAN-PCB-LNK, originally LINKAGE SECTION storage
*> bound only through the separate ENTRY 'DLITCBL' -- mockymock's driver
*> never binds it. The engine neutralizes it into real WORKING-STORAGE
*> automatically; a MOCK CALL "CBLTDLI" body can set LOAN-STATUS exactly
*> like any other mocked CALL's output.

TESTCASE "1000-INITIALIZE primes the first loan segment when CBLTDLI succeeds"
    MOCK OPEN RECOVIN
    END-MOCK
    MOCK OPEN RECOVRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    *> Mocking the whole READ removes its NOT AT END clause body too, so the
    *> mock body must set the WORKING-STORAGE targets directly, not the
    *> control-card record fields the removed code would have copied them
    *> from.
    MOCK READ RECOVIN
        MOVE 060 TO WS-DPD-THRESHOLD
        MOVE 1000.00 TO WS-MIN-BAL
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO LOAN-STATUS
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-DPD-THRESHOLD TO BE 60
    EXPECT WS-MIN-BAL TO BE 1000.00
    EXPECT WS-EOF-FLAG TO BE "N"
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE
    VERIFY READ RECOVIN WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "1000-INITIALIZE flags EOF when CBLTDLI reports an empty database"
    MOCK OPEN RECOVIN
    END-MOCK
    MOCK OPEN RECOVRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK READ RECOVIN
        MOVE 090 TO WS-DPD-THRESHOLD
        MOVE 0 TO WS-MIN-BAL
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE "GB" TO LOAN-STATUS
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-EOF-FLAG TO BE "Y"

TESTCASE "1000-INITIALIZE flags EOF on an unexpected CBLTDLI status while priming"
    MOCK OPEN RECOVIN
    END-MOCK
    MOCK OPEN RECOVRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK READ RECOVIN
        MOVE 090 TO WS-DPD-THRESHOLD
        MOVE 0 TO WS-MIN-BAL
    END-MOCK
    MOCK CALL "CBLTDLI"
        MOVE "AB" TO LOAN-STATUS
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT WS-EOF-FLAG TO BE "Y"

TESTCASE "2100-EVALUATE-RECOVERY-CRITERIA accepts a delinquent loan past threshold with balance above minimum"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "DL" TO LOAN-IO-STATUS
    MOVE 075 TO LOAN-IO-DPD
    MOVE "2500.00" TO LOAN-IO-BAL-CHAR
    PERFORM 2100-EVALUATE-RECOVERY-CRITERIA
    EXPECT WS-RECORD-ERROR TO BE "N"

TESTCASE "2100-EVALUATE-RECOVERY-CRITERIA rejects a loan that is not in DL status"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "AC" TO LOAN-IO-STATUS
    MOVE 200 TO LOAN-IO-DPD
    MOVE "2500.00" TO LOAN-IO-BAL-CHAR
    PERFORM 2100-EVALUATE-RECOVERY-CRITERIA
    EXPECT WS-RECORD-ERROR TO BE "Y"

TESTCASE "2100-EVALUATE-RECOVERY-CRITERIA rejects a loan whose DPD is under the threshold"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "DL" TO LOAN-IO-STATUS
    MOVE 030 TO LOAN-IO-DPD
    MOVE "2500.00" TO LOAN-IO-BAL-CHAR
    PERFORM 2100-EVALUATE-RECOVERY-CRITERIA
    EXPECT WS-RECORD-ERROR TO BE "Y"

TESTCASE "2100-EVALUATE-RECOVERY-CRITERIA rejects a loan with a non-numeric balance"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "DL" TO LOAN-IO-STATUS
    MOVE 200 TO LOAN-IO-DPD
    MOVE "NOT-A-NUM" TO LOAN-IO-BAL-CHAR
    PERFORM 2100-EVALUATE-RECOVERY-CRITERIA
    EXPECT WS-RECORD-ERROR TO BE "Y"

TESTCASE "2100-EVALUATE-RECOVERY-CRITERIA rejects a loan whose balance is below the minimum"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "DL" TO LOAN-IO-STATUS
    MOVE 200 TO LOAN-IO-DPD
    MOVE "500.00" TO LOAN-IO-BAL-CHAR
    PERFORM 2100-EVALUATE-RECOVERY-CRITERIA
    EXPECT WS-RECORD-ERROR TO BE "Y"

TESTCASE "2200-MARK-FOR-RECOVERY marks the segment RC when REPL succeeds"
    MOVE "LN0000010001" TO LOAN-IO-LOAN-NUM
    MOVE "CIF0000010" TO LOAN-IO-CIF
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO LOAN-STATUS
    END-MOCK
    PERFORM 2200-MARK-FOR-RECOVERY
    EXPECT LOAN-IO-STATUS TO BE "RC"
    EXPECT WS-SEGS-MARKED TO BE 1
    EXPECT WS-REPL-ERRORS TO BE 0
    EXPECT WS-DET-ACTION TO BE "MARKED RECOV"
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2200-MARK-FOR-RECOVERY reverts the status and counts an error when REPL fails"
    MOVE "LN0000010002" TO LOAN-IO-LOAN-NUM
    MOVE "CIF0000011" TO LOAN-IO-CIF
    MOCK CALL "CBLTDLI"
        MOVE "GE" TO LOAN-STATUS
    END-MOCK
    PERFORM 2200-MARK-FOR-RECOVERY
    EXPECT LOAN-IO-STATUS TO BE "DL"
    EXPECT WS-REPL-ERRORS TO BE 1
    EXPECT WS-SEGS-MARKED TO BE 0
    EXPECT WS-DET-ACTION TO BE "REPL ERROR"
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2400-WRITE-DETAIL writes the audit line reflecting the current loan segment"
    MOVE "LN0000010003" TO LOAN-IO-LOAN-NUM
    MOVE "CIF0000030" TO LOAN-IO-CIF
    MOVE 145 TO LOAN-IO-DPD
    MOVE "RC" TO LOAN-IO-STATUS
    MOVE 7500.50 TO WS-BAL-WORK
    MOCK WRITE RPT-RECORD
    END-MOCK
    PERFORM 2400-WRITE-DETAIL
    EXPECT WS-DET-LOAN TO BE "LN0000010003"
    EXPECT WS-DET-CIF TO BE "CIF0000030"
    EXPECT WS-DET-STATUS TO BE "RC"
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "2500-GET-NEXT-LOAN holds the next segment when GHN succeeds"
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO LOAN-STATUS
    END-MOCK
    PERFORM 2500-GET-NEXT-LOAN
    EXPECT WS-EOF-FLAG TO BE "N"
    EXPECT WS-REPL-ERRORS TO BE 0
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE

TESTCASE "2500-GET-NEXT-LOAN signals end-of-database on GHN GB status"
    MOCK CALL "CBLTDLI"
        MOVE "GB" TO LOAN-STATUS
    END-MOCK
    PERFORM 2500-GET-NEXT-LOAN
    EXPECT WS-EOF-FLAG TO BE "Y"
    EXPECT WS-REPL-ERRORS TO BE 0

TESTCASE "2500-GET-NEXT-LOAN counts a DL/I error and stops the scan on an unexpected GHN status"
    MOCK CALL "CBLTDLI"
        MOVE "AB" TO LOAN-STATUS
    END-MOCK
    PERFORM 2500-GET-NEXT-LOAN
    EXPECT WS-EOF-FLAG TO BE "Y"
    EXPECT WS-REPL-ERRORS TO BE 1

TESTCASE "2000-SCAN-AND-MARK marks and reports an eligible loan within one scan iteration"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "LN0000020001" TO LOAN-IO-LOAN-NUM
    MOVE "CIF0000020" TO LOAN-IO-CIF
    MOVE "DL" TO LOAN-IO-STATUS
    MOVE 150 TO LOAN-IO-DPD
    MOVE "8250.00" TO LOAN-IO-BAL-CHAR
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO LOAN-STATUS
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    PERFORM 2000-SCAN-AND-MARK
    EXPECT WS-SEGS-SCANNED TO BE 1
    EXPECT WS-SEGS-MARKED TO BE 1
    EXPECT WS-SEGS-SKIPPED TO BE 0
    EXPECT WS-DET-ACTION TO BE "MARKED RECOV"
    *> REPL (mark) then GHN (advance) -- both fire for an eligible segment
    VERIFY CALL "CBLTDLI" WAS CALLED 2 TIMES
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "2000-SCAN-AND-MARK skips an ineligible loan and still advances to the next segment"
    MOVE 060 TO WS-DPD-THRESHOLD
    MOVE 1000.00 TO WS-MIN-BAL
    MOVE "LN0000020003" TO LOAN-IO-LOAN-NUM
    MOVE "CIF0000030" TO LOAN-IO-CIF
    MOVE "PD" TO LOAN-IO-STATUS
    MOVE 200 TO LOAN-IO-DPD
    MOVE "500.00" TO LOAN-IO-BAL-CHAR
    MOCK CALL "CBLTDLI"
        MOVE SPACES TO LOAN-STATUS
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    PERFORM 2000-SCAN-AND-MARK
    EXPECT WS-SEGS-SCANNED TO BE 1
    EXPECT WS-SEGS-SKIPPED TO BE 1
    EXPECT WS-SEGS-MARKED TO BE 0
    EXPECT WS-DET-ACTION TO BE "SKIPPED"
    *> only the 2500 GHN advance call fires; 2200's REPL never runs for a
    *> skipped segment
    VERIFY CALL "CBLTDLI" WAS CALLED ONCE
    VERIFY WRITE RPT-RECORD WAS CALLED ONCE

TESTCASE "3000-FINALIZE returns a clean return code when no REPL errors occurred"
    MOVE ZERO TO WS-REPL-ERRORS
    MOCK CLOSE RECOVIN
    END-MOCK
    MOCK CLOSE RECOVRPT
    END-MOCK
    PERFORM 3000-FINALIZE
    EXPECT RETURN-CODE TO BE 0

TESTCASE "3000-FINALIZE returns return code 8 when REPL errors occurred"
    MOVE 3 TO WS-REPL-ERRORS
    MOCK CLOSE RECOVIN
    END-MOCK
    MOCK CLOSE RECOVRPT
    END-MOCK
    PERFORM 3000-FINALIZE
    EXPECT RETURN-CODE TO BE 8

TESTCASE "0000-MAIN-PROCESS runs end-to-end via its real entry point across two loans until end-of-database"
    *> GOBACK is reached via a plain PERFORM chain (1000-INITIALIZE,
    *> 2000-SCAN-AND-MARK repeated until EOF, 3000-FINALIZE), neutralized
    *> instead of killing the suite.
    *>
    *> Call sequence: #1 primes loan A (init GHN); #2 REPL marks loan A
    *> recovered; #3 GHN advances and holds loan B (DPD below threshold,
    *> so it will be skipped); #4 GHN reports end-of-database.
    MOCK OPEN RECOVIN
    END-MOCK
    MOCK OPEN RECOVRPT
    END-MOCK
    MOCK WRITE RPT-RECORD
    END-MOCK
    MOCK READ RECOVIN
        MOVE 060 TO WS-DPD-THRESHOLD
        MOVE 1000.00 TO WS-MIN-BAL
    END-MOCK
    MOCK CALL "CBLTDLI"
        EVALUATE UT-CBLTDLI-TALLY
            WHEN 1
                MOVE SPACES TO LOAN-STATUS
                MOVE "LN0000030001" TO LOAN-IO-LOAN-NUM
                MOVE "CIF0000301" TO LOAN-IO-CIF
                MOVE "DL" TO LOAN-IO-STATUS
                MOVE 150 TO LOAN-IO-DPD
                MOVE "8250.00" TO LOAN-IO-BAL-CHAR
            WHEN 2
                MOVE SPACES TO LOAN-STATUS
            WHEN 3
                MOVE SPACES TO LOAN-STATUS
                MOVE "LN0000030002" TO LOAN-IO-LOAN-NUM
                MOVE "CIF0000302" TO LOAN-IO-CIF
                MOVE "DL" TO LOAN-IO-STATUS
                MOVE 015 TO LOAN-IO-DPD
                MOVE "9000.00" TO LOAN-IO-BAL-CHAR
            WHEN 4
                MOVE "GB" TO LOAN-STATUS
        END-EVALUATE
    END-MOCK
    MOCK CLOSE RECOVIN
    END-MOCK
    MOCK CLOSE RECOVRPT
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-EOF-FLAG TO BE "Y"
    EXPECT WS-SEGS-SCANNED TO BE 2
    EXPECT WS-SEGS-MARKED TO BE 1
    EXPECT WS-SEGS-SKIPPED TO BE 1
    EXPECT WS-REPL-ERRORS TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY CALL "CBLTDLI" WAS CALLED 4 TIMES
    *> header line plus one detail line per scanned loan (marked + skipped)
    VERIFY WRITE RPT-RECORD WAS CALLED 3 TIMES
    VERIFY OPEN RECOVIN WAS CALLED ONCE
    VERIFY OPEN RECOVRPT WAS CALLED ONCE
    VERIFY CLOSE RECOVIN WAS CALLED ONCE
    VERIFY CLOSE RECOVRPT WAS CALLED ONCE
