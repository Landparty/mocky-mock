TESTSUITE "CTRRPT"

*> CTRRPT is a BSA/AML Currency Transaction Report generator. It scans
*> today's DB2 transactions (CTR_CURSOR, joined/aggregated per account),
*> and for every account whose aggregated cash-in or cash-out for the day
*> is >= $10,000 it files a regulatory record. Within that population it
*> further flags "structuring" (more than 3 transactions AND aggregated
*> cash-in between $9,000 and just under $10,000 -- an attempt to stay
*> under the CTR threshold) as a SAR instead of a plain CTR. These cases
*> exercise: the cursor-open failure abort, the CTR vs. SAR classification
*> (including both of its boundary edges), the regulatory-insert failure
*> path, the fetch-error/FATAL-ERROR-FOUND early halt, an empty business
*> day, and multi-account aggregation in a single run.

*> 1000-INITIALIZE: if CTR_CURSOR fails to open, the program must abort
*> immediately with RETURN-CODE 16 and never attempt to detect/file any
*> transactions.
TESTCASE "1000-INITIALIZE: CTR_CURSOR open failure aborts the run"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "OPEN"
        MOVE -805 TO SQLCODE
    END-MOCK
    PERFORM 1000-INITIALIZE
    EXPECT RETURN-CODE TO BE 16
    VERIFY OPEN CTRRPT WAS CALLED ONCE
    VERIFY OPEN CTRFILE WAS CALLED ONCE
    VERIFY SQL "OPEN" WAS CALLED ONCE
    VERIFY WRITE CTRRPT-RECORD WAS CALLED 2 TIMES

*> Happy path: a single account's daily cash-in is well above the
*> $10,000 CTR threshold with a normal transaction count -- a plain CTR,
*> not a SAR.
TESTCASE "2200-CREATE-CTR-RECORD: cash-in over the CTR threshold files a plain CTR"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000001", HV-CIF-NUMBER = "CIF0000001", HV-FIRST-NAME = "ROBERT", HV-LAST-NAME = "WILSON", HV-SSN = "123456789", HV-ADDR1 = "100 MAIN ST", HV-CITY = "CHICAGO", HV-STATE = "IL", HV-ZIP = "60601", HV-DOB = "1975-03-14", HV-TOTAL-CASH-IN = 15000.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 5 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-RPT-TYPE TO BE "CTR"
    EXPECT WS-CTRS-FILED TO BE 1
    EXPECT WS-SARS-FLAGGED TO BE 0
    EXPECT WS-CTR-ERRORS TO BE 0
    EXPECT WS-TOTAL-CASH-IN TO BE 15000.00
    EXPECT WS-RECORD-COUNT TO BE 1
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS PERFORMED 2 TIMES
    VERIFY SQL "INSERT" WAS CALLED ONCE
    VERIFY WRITE CTR-OUTPUT-RECORD WAS CALLED ONCE
    VERIFY WRITE CTRRPT-RECORD WAS CALLED 3 TIMES

*> Structuring pattern: more than 3 transactions AND aggregated cash-in
*> sitting just under the $10,000 threshold (the classic "smurfing"
*> signature) must be flagged SAR instead of CTR, and still counted as
*> filed.
TESTCASE "2200-CREATE-CTR-RECORD: repeated sub-threshold deposits are flagged as a SAR"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000002", HV-CIF-NUMBER = "CIF0000002", HV-FIRST-NAME = "CHARLES", HV-LAST-NAME = "WILLIAMS", HV-SSN = "234567890", HV-ADDR1 = "200 ELM ST", HV-CITY = "DENVER", HV-STATE = "CO", HV-ZIP = "80201", HV-DOB = "1980-06-22", HV-TOTAL-CASH-IN = 9500.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 4 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-RPT-TYPE TO BE "SAR"
    EXPECT WS-SARS-FLAGGED TO BE 1
    EXPECT WS-CTRS-FILED TO BE 1
    EXPECT WS-TOTAL-CASH-IN TO BE 9500.00
    VERIFY SQL "INSERT" WAS CALLED ONCE

*> Boundary: exactly 3 transactions (not "more than 3") must NOT trigger
*> the structuring/SAR rule even though the amount is in the suspicious
*> band -- proves the AND's transaction-count leg is strictly ">".
TESTCASE "2200-CREATE-CTR-RECORD: three transactions in the SAR amount band stays a CTR"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000003", HV-CIF-NUMBER = "CIF0000003", HV-FIRST-NAME = "MICHAEL", HV-LAST-NAME = "TAYLOR", HV-SSN = "345678901", HV-ADDR1 = "300 OAK ST", HV-CITY = "DALLAS", HV-STATE = "TX", HV-ZIP = "75201", HV-DOB = "1990-11-02", HV-TOTAL-CASH-IN = 9500.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 3 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-RPT-TYPE TO BE "CTR"
    EXPECT WS-SARS-FLAGGED TO BE 0
    EXPECT WS-CTRS-FILED TO BE 1

*> Boundary: cash-in at exactly $10,000.00 (with a qualifying transaction
*> count) falls outside the SAR band's exclusive upper bound (< 10000)
*> and must file as a plain CTR, not a SAR.
TESTCASE "2200-CREATE-CTR-RECORD: cash-in at exactly the CTR threshold stays a CTR"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000004", HV-CIF-NUMBER = "CIF0000004", HV-FIRST-NAME = "KAREN", HV-LAST-NAME = "GARCIA", HV-SSN = "456789012", HV-ADDR1 = "400 PINE ST", HV-CITY = "AUSTIN", HV-STATE = "TX", HV-ZIP = "73301", HV-DOB = "1985-02-18", HV-TOTAL-CASH-IN = 10000.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 5 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-RPT-TYPE TO BE "CTR"
    EXPECT WS-SARS-FLAGGED TO BE 0
    EXPECT WS-CTRS-FILED TO BE 1

*> Boundary: cash-in at exactly $9,000.00 (the SAR band's inclusive lower
*> bound) with a qualifying transaction count IS flagged as a SAR.
TESTCASE "2200-CREATE-CTR-RECORD: cash-in at the structuring floor triggers a SAR"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000005", HV-CIF-NUMBER = "CIF0000005", HV-FIRST-NAME = "DOROTHY", HV-LAST-NAME = "BROWN", HV-SSN = "567890123", HV-ADDR1 = "500 CEDAR ST", HV-CITY = "PHOENIX", HV-STATE = "AZ", HV-ZIP = "85001", HV-DOB = "1968-09-30", HV-TOTAL-CASH-IN = 9000.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 10 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT HV-RPT-TYPE TO BE "SAR"
    EXPECT WS-SARS-FLAGGED TO BE 1
    EXPECT WS-CTRS-FILED TO BE 1

*> Error path: the regulatory INSERT itself fails (e.g. a DB2 duplicate
*> key). The error must be counted and the running cash totals must NOT
*> be credited for that record, but the FinCEN/report output lines are
*> still produced unconditionally -- proves WS-CTR-ERRORS/WS-TOTAL-CASH-IN
*> only move on the INSERT-success leg of the IF, and that the program
*> return code reflects the error.
TESTCASE "2200-CREATE-CTR-RECORD: a failed regulatory insert is counted as an error, not filed"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000006", HV-CIF-NUMBER = "CIF0000006", HV-FIRST-NAME = "MARIA", HV-LAST-NAME = "THOMAS", HV-SSN = "678901234", HV-ADDR1 = "600 BIRCH ST", HV-CITY = "MIAMI", HV-STATE = "FL", HV-ZIP = "33101", HV-DOB = "1972-12-05", HV-TOTAL-CASH-IN = 20000.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 6 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE -803 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-CTR-ERRORS TO BE 1
    EXPECT WS-CTRS-FILED TO BE 0
    EXPECT WS-TOTAL-CASH-IN TO BE 0.00
    EXPECT WS-TOTAL-CASH-OUT TO BE 0.00
    EXPECT RETURN-CODE TO BE 4
    VERIFY SQL "INSERT" WAS CALLED ONCE
    VERIFY WRITE CTR-OUTPUT-RECORD WAS CALLED ONCE
    VERIFY WRITE CTRRPT-RECORD WAS CALLED 3 TIMES

*> Error path: the cursor FETCH itself fails (not "no more rows") on the
*> very first fetch. The program must set FATAL-ERROR-FOUND, stop
*> fetching immediately, and never reach 2200-CREATE-CTR-RECORD for that
*> (nonexistent) row.
TESTCASE "2100-FETCH-CTR-TRANSACTION: a fetch error halts detection without filing anything"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH"
        MOVE -904 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-RECORD-COUNT TO BE 0
    EXPECT WS-CTRS-FILED TO BE 0
    EXPECT WS-SARS-FLAGGED TO BE 0
    VERIFY SQL "FETCH" WAS CALLED ONCE
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE CTR-OUTPUT-RECORD WAS CALLED NEVER
    VERIFY WRITE CTRRPT-RECORD WAS CALLED 2 TIMES

*> Empty business day: the cursor returns no rows at all (SQLCODE 100 on
*> the very first fetch). Nothing should be filed or flagged, and the
*> program should still complete cleanly.
TESTCASE "2000-DETECT-CTR-TRANSACTIONS: a day with no reportable transactions files nothing"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH"
        MOVE 100 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-RECORD-COUNT TO BE 0
    EXPECT WS-CTRS-FILED TO BE 0
    EXPECT WS-SARS-FLAGGED TO BE 0
    EXPECT RETURN-CODE TO BE 0
    VERIFY SQL "FETCH" WAS CALLED ONCE
    VERIFY SQL "INSERT" WAS CALLED NEVER
    VERIFY WRITE CTR-OUTPUT-RECORD WAS CALLED NEVER

*> Aggregation: two different accounts reported in the same run -- one a
*> plain CTR, one a SAR -- must both be filed and their cash amounts
*> summed correctly into the run-level totals, and every WRITE fires once
*> per detail record on top of the two report headers.
TESTCASE "2000-DETECT-CTR-TRANSACTIONS: aggregates totals across a CTR and a SAR in the same run"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "FETCH" ROWS
        ( HV-ACCT-NUMBER = "ACCT00000007", HV-CIF-NUMBER = "CIF0000007", HV-FIRST-NAME = "JAMES", HV-LAST-NAME = "MARTIN", HV-SSN = "789012345", HV-ADDR1 = "700 MAPLE ST", HV-CITY = "SEATTLE", HV-STATE = "WA", HV-ZIP = "98101", HV-DOB = "1965-04-11", HV-TOTAL-CASH-IN = 12000.00, HV-TOTAL-CASH-OUT = 500.00, HV-TRAN-COUNT = 6 )
        ( HV-ACCT-NUMBER = "ACCT00000008", HV-CIF-NUMBER = "CIF0000008", HV-FIRST-NAME = "PATRICIA", HV-LAST-NAME = "LEE", HV-SSN = "890123456", HV-ADDR1 = "800 SPRUCE ST", HV-CITY = "PORTLAND", HV-STATE = "OR", HV-ZIP = "97201", HV-DOB = "1988-07-19", HV-TOTAL-CASH-IN = 9200.00, HV-TOTAL-CASH-OUT = 0.00, HV-TRAN-COUNT = 5 )
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    EXPECT WS-RECORD-COUNT TO BE 2
    EXPECT WS-CTRS-FILED TO BE 2
    EXPECT WS-SARS-FLAGGED TO BE 1
    EXPECT WS-CTR-ERRORS TO BE 0
    EXPECT WS-TOTAL-CASH-IN TO BE 21200.00
    EXPECT WS-TOTAL-CASH-OUT TO BE 500.00
    VERIFY SQL "FETCH" WAS PERFORMED 3 TIMES
    VERIFY SQL "INSERT" WAS CALLED 2 TIMES
    VERIFY WRITE CTR-OUTPUT-RECORD WAS CALLED 2 TIMES
    VERIFY WRITE CTRRPT-RECORD WAS CALLED 4 TIMES
