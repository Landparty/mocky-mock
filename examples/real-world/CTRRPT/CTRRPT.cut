TESTSUITE "CTRRPT"

TESTCASE "2100-FETCH-CTR-TRANSACTION: WHEN OTHER"
    MOCK OPEN CTRRPT
    END-MOCK
    MOCK OPEN CTRFILE
    END-MOCK
    MOCK SQL "OPEN"
    END-MOCK
    MOCK SQL "FETCH"
        MOVE "HV000000001" TO HV-ACCT-NUMBER
        MOVE "IPOC9E55WX" TO HV-CIF-NUMBER
        MOVE "ROBERT" TO HV-FIRST-NAME
        MOVE "WILSON" TO HV-LAST-NAME
        MOVE "206TR5LLD" TO HV-SSN
        MOVE "48YDT1KX4XHVCW1L151FZS3L64RH6J0Y" TO HV-ADDR1
        MOVE "CHICAGO" TO HV-CITY
        MOVE "VA" TO HV-STATE
        MOVE "04676" TO HV-ZIP
        MOVE "1996-01-04" TO HV-DOB
        MOVE -499999999995500.00 TO HV-TOTAL-CASH-IN
        MOVE 865509.85 TO HV-TOTAL-CASH-OUT
        MOVE -499999998 TO HV-TRAN-COUNT
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK SQL "COMMIT"
    END-MOCK
    MOCK SQL "CLOSE"
    END-MOCK
    MOCK CLOSE CTRRPT
    END-MOCK
    MOCK WRITE CTRRPT-RECORD
    END-MOCK
    MOCK SQL "INSERT"
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK WRITE CTR-OUTPUT-RECORD
    END-MOCK
    PERFORM 0000-MAIN-PROCESS
    VERIFY OPEN CTRRPT WAS CALLED 1 TIMES
    VERIFY OPEN CTRFILE WAS CALLED 1 TIMES
    VERIFY SQL "OPEN" WAS CALLED 1 TIMES
    VERIFY SQL "FETCH" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "COMMIT" WAS CALLED 1 TIMES
    VERIFY SQL "CLOSE" WAS CALLED 1 TIMES
    VERIFY CLOSE CTRRPT WAS CALLED 1 TIMES

