TESTSUITE "FIXTUREDEMO"

TESTCASE "happy path"
    MOCK ACCEPT WS-CUSTOMER-ID
        MOVE "WS001" TO WS-CUSTOMER-ID
    END-MOCK
    MOCK OPEN ORDER-FILE
    END-MOCK
    MOCK CLOSE ORDER-FILE
    END-MOCK
    MOCK SQL "SELECT"
        MOVE "CHARLES GARCIA" TO WS-CUST-NAME
        MOVE "WS001" TO WS-CUSTOMER-ID
        MOVE 0 TO SQLCODE
    END-MOCK
    MOCK CALL "LOGALERT"
        CAPTURE ARG 1 INTO UT-CAP-LOGALERT-1
        MOVE "UJ" TO WS-ALERT-STATUS
    END-MOCK
    MOCK READ ORDER-FILE
        EVALUATE TRUE
            WHEN UT-READ-ORDER-FILE-TALLY = 1
                MOVE "ORD001" TO ORDER-ID
                MOVE 447 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 2
                MOVE "ORD002" TO ORDER-ID
                MOVE 732 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 3
                MOVE "ORD003" TO ORDER-ID
                MOVE 648 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 4
                MOVE "ORD004" TO ORDER-ID
                MOVE 341 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 5
                MOVE "ORD005" TO ORDER-ID
                MOVE 738 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 6
                MOVE "ORD006" TO ORDER-ID
                MOVE 673 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 7
                MOVE "ORD007" TO ORDER-ID
                MOVE 110 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 8
                MOVE "ORD008" TO ORDER-ID
                MOVE 568 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 9
                MOVE "ORD009" TO ORDER-ID
                MOVE 74 TO ORDER-QTY
            WHEN UT-READ-ORDER-FILE-TALLY = 10
                MOVE "ORD010" TO ORDER-ID
                MOVE 271 TO ORDER-QTY
            WHEN OTHER
                MOVE "10" TO WS-ORDER-STATUS
                *> end of file: the splice runs this READ's own AT END clause (line 56) after the mock
        END-EVALUATE
    END-MOCK
    PERFORM MAIN-PROCESS
    *> STUB EXPECT UT-CAP-LOGALERT-1 -- the value the program actually passed to this CALL
    VERIFY ACCEPT WS-CUSTOMER-ID WAS CALLED 1 TIMES
    VERIFY OPEN ORDER-FILE WAS CALLED 1 TIMES
    VERIFY CLOSE ORDER-FILE WAS CALLED 1 TIMES
    VERIFY SQL "SELECT" WAS CALLED 1 TIMES
    VERIFY CALL "LOGALERT" WAS CALLED 1 TIMES
    *> STUB EXPECT WS-ALERT-STATUS -- bidirectional: the OUT aspect (value the caller supplies) is not asserted in v1 (provenance=assumed-bidirectional)
    VERIFY READ ORDER-FILE WAS CALLED 11 TIMES
