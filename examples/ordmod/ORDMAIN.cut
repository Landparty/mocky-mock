TESTSUITE "ORDMAIN load module: validate, publish, log"

*> ORDVAL, ORDPUB and ORDLOG run for real. DB2, MQ, the files, DATEUTL
*> and the dynamic audit CALL are mocked, inside the subprograms too.
BEFORE-EACH
    USE REAL CALL "ORDPUB" FROM "ORDPUB.cbl"
    USE REAL CALL "ORDVAL" FROM "ORDVAL.cbl"
    USE REAL CALL "ORDLOG" FROM "ORDLOG.cbl"
    MOCK CALL "DATEUTL"
        MOVE "20261101" TO WS-RUN-DATE
    END-MOCK
    MOCK CALL WS-AUDIT-PGM
    END-MOCK
    MOCK OPEN ORDER-FILE
    END-MOCK
    MOCK CLOSE ORDER-FILE
    END-MOCK
    *> ORDVAL: the customer's credit limit (body runs in ORDVAL)
    MOCK SQL "SELECT"
        EVALUATE WS-CUST
            WHEN "C00001"
                MOVE 0 TO SQLCODE
                MOVE 500.00 TO WS-LIMIT
            WHEN "C00002"
                MOVE 0 TO SQLCODE
                MOVE 100.00 TO WS-LIMIT
            WHEN OTHER
                MOVE 100 TO SQLCODE
        END-EVALUATE
    END-MOCK
    *> ORDPUB: the status update after a publish
    MOCK SQL "UPDATE"
        MOVE 0 TO SQLCODE
    END-MOCK
    *> ORDLOG: the log file
    MOCK OPEN LOG-FILE
    END-MOCK
    MOCK WRITE LOG-LINE
    END-MOCK
    MOCK CLOSE LOG-FILE
    END-MOCK
    *> ORDPUB: MQ (bodies run in ORDPUB and name its fields)
    MOCK MQ "MQOPEN"
        MOVE 0 TO WS-COMPCODE
    END-MOCK
    MOCK MQ "MQPUT"
        MOVE 0 TO WS-COMPCODE
    END-MOCK
    MOCK MQ "MQCLOSE"
        MOVE 0 TO WS-COMPCODE
    END-MOCK
END-BEFORE

TESTCASE "orders under the limit are published, one over it is rejected"
    MOCK READ ORDER-FILE ROWS
        (ORDER-IN = "O00001C000010012500 ")
        (ORDER-IN = "O00002C000020025000 ")
        (ORDER-IN = "O00005C000020005000 ")
    END-MOCK
    PERFORM 0000-MAIN
    EXPECT WS-ACCEPTED TO BE 2
    EXPECT WS-REJECTED TO BE 1
    VERIFY CALL "ORDVAL" WAS CALLED 3 TIMES
    VERIFY CALL "ORDPUB" WAS CALLED 2 TIMES
    VERIFY CALL "ORDLOG" WAS CALLED 3 TIMES
    VERIFY MQ "MQPUT" WAS CALLED 2 TIMES
    VERIFY SQL "UPDATE" WAS CALLED 2 TIMES
    VERIFY WRITE LOG-LINE WAS PERFORMED 3 TIMES

TESTCASE "an unknown customer is rejected and never reaches MQ"
    MOCK READ ORDER-FILE ROWS
        (ORDER-IN = "O00003C999990000100 ")
    END-MOCK
    PERFORM 0000-MAIN
    EXPECT WS-ACCEPTED TO BE 0
    EXPECT WS-REJECTED TO BE 1
    EXPECT WS-VAL-RC TO BE 8
    VERIFY CALL "ORDPUB" WAS CALLED NEVER
    VERIFY MQ "MQOPEN" WAS CALLED NEVER
    VERIFY CALL "ORDLOG" WAS CALLED ONCE

TESTCASE "a failed MQOPEN publishes nothing and updates nothing"
    MOCK MQ "MQOPEN"
        MOVE 2 TO WS-COMPCODE
        MOVE 2085 TO WS-REASON
    END-MOCK
    MOCK READ ORDER-FILE ROWS
        (ORDER-IN = "O00004C000010000100 ")
    END-MOCK
    PERFORM 0000-MAIN
    EXPECT WS-ACCEPTED TO BE 1
    VERIFY MQ "MQPUT" WAS CALLED NEVER
    VERIFY SQL "UPDATE" WAS CALLED NEVER
    VERIFY MQ "MQCLOSE" WAS CALLED NEVER
