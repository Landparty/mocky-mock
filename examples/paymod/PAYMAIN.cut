TESTSUITE "PAYMAIN load module"

BEFORE-EACH
    USE REAL CALL "PAYCALC" FROM "PAYCALC.cbl"
    MOCK CALL "DATEUTL"
        MOVE "20261101" TO WS-RUN-DATE
    END-MOCK
    MOCK OPEN EMP-FILE
    END-MOCK
    MOCK CLOSE EMP-FILE
    END-MOCK
END-BEFORE

TESTCASE "prices two employees through the real PAYCALC"
    MOCK READ EMP-FILE ROWS
        (EMP-ID = "E00001", EMP-HOURS = 40, EMP-GRADE = "A1")
        (EMP-ID = "E00002", EMP-HOURS = 45, EMP-GRADE = "B2")
    END-MOCK
    MOCK SQL "SELECT HOURLY_RATE"
        MOVE 0 TO SQLCODE
        MOVE 20.00 TO WS-RATE
    END-MOCK
    PERFORM 0000-MAIN
    EXPECT WS-EMP-COUNT TO BE 2
    EXPECT WS-TOTAL-PAY TO BE 1750.00
    VERIFY CALL "PAYCALC" WAS CALLED 2 TIMES
    VERIFY SQL "SELECT HOURLY_RATE" WAS CALLED 2 TIMES

TESTCASE "a grade DB2 does not know is skipped"
    MOCK READ EMP-FILE ROWS
        (EMP-ID = "E00003", EMP-HOURS = 10, EMP-GRADE = "ZZ")
    END-MOCK
    MOCK SQL "SELECT HOURLY_RATE"
        MOVE 100 TO SQLCODE
    END-MOCK
    PERFORM 0000-MAIN
    EXPECT WS-EMP-COUNT TO BE 0
    EXPECT WS-TOTAL-PAY TO BE 0
    VERIFY CALL "PAYCALC" WAS CALLED ONCE
