//CUSTJOB  JOB (ACCT),'CUSTOMER REPORT',CLASS=A,MSGCLASS=X
//* Extract the customers over the limit, sort them, report them.
//CLEANUP  EXEC PGM=IEFBR14
//OLDRPT   DD DSN=PROD.CUST.REPORT,DISP=(MOD,DELETE,DELETE),
//            SPACE=(TRK,1)
//EXTRACT  EXEC PGM=CUSTEXT
//CUSTIN   DD DSN=PROD.CUST.MASTER,DISP=SHR
//CUSTOUT  DD DSN=&&HIGH,DISP=(NEW,PASS),
//            DCB=(RECFM=FB,LRECL=20)
//SORTHI   EXEC PGM=SORT,COND=(4,LE,EXTRACT)
//SORTIN   DD DSN=&&HIGH,DISP=(OLD,DELETE)
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),
//            DCB=(RECFM=FB,LRECL=20)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(6,10,CH,A)
/*
//REPORT   EXEC PGM=CUSTRPT,COND=(4,LE)
//RPTIN    DD DSN=&&SORTED,DISP=(OLD,DELETE)
//RPTOUT   DD DSN=PROD.CUST.REPORT,DISP=(NEW,CATLG,DELETE),
//            DCB=(RECFM=FB,LRECL=40)
