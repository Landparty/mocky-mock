//VSAMJOB  JOB (ACCT),'VSAM MAINT',CLASS=A,MSGCLASS=X
//APPLY    EXEC PGM=VSKSDSR
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//TRANIN   DD DSN=PROD.ACCT.TRANS,DISP=SHR
//ACCTKSDS DD DSN=PROD.ACCT.KSDS,DISP=SHR
//BROWSE   EXEC PGM=VSKSDSD
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//PARMIN   DD DSN=PROD.BROWSE.PARM,DISP=SHR
//CUSTKSDS DD DSN=PROD.CUST.KSDS,DISP=SHR
//RPTOUT   DD SYSOUT=*
//AUDIT    EXEC PGM=VSESDS
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//EVTIN    DD DSN=PROD.EVENTS,DISP=SHR
//AUDESDS  DD DSN=PROD.AUDIT.ESDS,DISP=SHR
//SLOTS    EXEC PGM=VSRRDS
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//REQIN    DD DSN=PROD.SLOT.REQ,DISP=SHR
//SLOTRRDS DD DSN=PROD.SLOT.RRDS,DISP=SHR
