CUSTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               STORAGE=AUTO,CTRL=FREEKB
CUSTMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(5,2),LENGTH=12,ATTRB=PROT,INITIAL='CUSTOMER ID:'
CUSTID   DFHMDF POS=(5,20),LENGTH=6,ATTRB=(UNPROT,NUM,IC)
         DFHMDF POS=(7,2),LENGTH=5,ATTRB=PROT,INITIAL='NAME:'
CUSTNM   DFHMDF POS=(7,20),LENGTH=20,ATTRB=PROT
MSG      DFHMDF POS=(22,2),LENGTH=30,ATTRB=PROT
         DFHMSD TYPE=FINAL
         END
