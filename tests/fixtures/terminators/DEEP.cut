TESTSUITE "DEEP"

TESTCASE "the STOP RUN after a premature end ends the case"
    MOCK OPEN IN-FILE
    END-MOCK
    MOCK READ IN-FILE
        MOVE "10" TO IN-FS
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    PERFORM MAIN-LINE
    EXPECT AFTER-READ TO BE 9
    EXPECT READS TO BE 0
    VERIFY CLOSE IN-FILE WAS CALLED 1 TIMES

TESTCASE "the next case still runs"
    MOCK OPEN IN-FILE
    END-MOCK
    MOCK READ IN-FILE
        MOVE "00" TO IN-FS
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    PERFORM MAIN-LINE
    EXPECT AFTER-READ TO BE 2
    EXPECT READS TO BE 2
