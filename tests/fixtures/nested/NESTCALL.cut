TESTSUITE "NESTCALL"

TESTCASE "the nested program's CALL is mocked"
    MOCK CALL "INNER"
        MOVE 0 TO WS-RC
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-STEP TO BE "DONE"
    VERIFY CALL "INNER" WAS CALLED 1 TIMES

TESTCASE "a failed CALL reaches the STOP RUN"
    MOCK CALL "INNER"
        MOVE 8 TO WS-RC
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-STEP TO BE "FAIL"

TESTCASE "the next case still runs"
    MOCK CALL "INNER"
        MOVE 1 TO WS-RC
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-STEP TO BE "DONE"
