TESTSUITE "DECL"

TESTCASE "an AT END READ handles its own end, a bare one runs the USE"
    MOCK OPEN IN-FILE
    END-MOCK
    MOCK READ IN-FILE
        MOVE "10" TO IN-FS
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    PERFORM READ-ALL
    EXPECT ENDS TO BE 1
    EXPECT INPUT-ERRORS TO BE 1

TESTCASE "a failed OPEN INPUT runs the INPUT procedure"
    MOCK OPEN IN-FILE
        FILE-STATUS IS "35"
    END-MOCK
    MOCK READ IN-FILE
        MOVE "X" TO IN-REC
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    PERFORM READ-ALL
    EXPECT INPUT-ERRORS TO BE 1
    EXPECT ENDS TO BE 0

TESTCASE "an OUTPUT file has no procedure"
    MOCK OPEN OUT-FILE
    END-MOCK
    MOCK WRITE OUT-REC
        FILE-STATUS IS "34"
    END-MOCK
    MOCK CLOSE OUT-FILE
    END-MOCK
    PERFORM WRITE-ONE
    EXPECT INPUT-ERRORS TO BE 0

TESTCASE "a file's own procedure wins over its mode's"
    MOCK OPEN KEY-FILE
    END-MOCK
    MOCK READ KEY-FILE
        MOVE "10" TO UT-MOCK-STATUS
    END-MOCK
    MOCK CLOSE KEY-FILE
    END-MOCK
    PERFORM READ-KEYS
    EXPECT KEY-ERRORS TO BE 1
    EXPECT INPUT-ERRORS TO BE 0
