       IDENTIFICATION DIVISION.
       PROGRAM-ID. DECL.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT IN-FILE ASSIGN TO "IN" FILE STATUS IS IN-FS.
           SELECT OUT-FILE ASSIGN TO "OUT" FILE STATUS IS OUT-FS.
           SELECT KEY-FILE ASSIGN TO "KEY".
       DATA DIVISION.
       FILE SECTION.
       FD IN-FILE.
       01 IN-REC PIC X(10).
       FD OUT-FILE.
       01 OUT-REC PIC X(10).
       FD KEY-FILE.
       01 KEY-REC PIC X(10).
       WORKING-STORAGE SECTION.
       01 IN-FS PIC XX.
       01 OUT-FS PIC XX.
       01 INPUT-ERRORS PIC 9 VALUE 0.
       01 KEY-ERRORS PIC 9 VALUE 0.
       01 ENDS PIC 9 VALUE 0.
       PROCEDURE DIVISION.
       DECLARATIVES.
       INPUT-ERROR SECTION.
           USE AFTER STANDARD EXCEPTION PROCEDURE ON INPUT.
       INPUT-ERROR-1.
           ADD 1 TO INPUT-ERRORS.
       KEY-ERROR SECTION.
           USE AFTER ERROR PROCEDURE ON KEY-FILE.
       KEY-ERROR-1.
           ADD 1 TO KEY-ERRORS.
       END DECLARATIVES.
       MAIN SECTION.
       READ-ALL.
           OPEN INPUT IN-FILE
           READ IN-FILE AT END ADD 1 TO ENDS END-READ
           READ IN-FILE
           CLOSE IN-FILE.
       WRITE-ONE.
           OPEN OUTPUT OUT-FILE
           WRITE OUT-REC
           CLOSE OUT-FILE.
       READ-KEYS.
           OPEN INPUT KEY-FILE
           READ KEY-FILE
           CLOSE KEY-FILE.
