TESTSUITE "MIXSORT"

TESTCASE "the output procedure runs after the mocked file side"
    MOCK SORT SORT-FILE
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "AAAA")
    (SORT-KEY = "BBBB")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-LAST TO BE "DONE"
    VERIFY SORT SORT-FILE WAS CALLED 1 TIMES

TESTCASE "a STOP RUN in the output procedure ends the case"
    MOCK SORT SORT-FILE
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "AAAA")
    (SORT-KEY = "STOP")
    (SORT-KEY = "ZZZZ")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-LAST TO BE "STOP"

TESTCASE "the next case still runs"
    MOCK SORT SORT-FILE
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "CCCC")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 1
    EXPECT WS-LAST TO BE "DONE"
