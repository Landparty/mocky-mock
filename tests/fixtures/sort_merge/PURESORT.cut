TESTSUITE "PURESORT"

TESTCASE "both procedures run"
    MOCK RELEASE SORT-REC
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "AAAA")
    (SORT-KEY = "BBBB")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-LAST TO BE "DONE"
    VERIFY RELEASE SORT-REC WAS CALLED 1 TIMES

TESTCASE "a STOP RUN in the output procedure ends the case"
    MOCK RELEASE SORT-REC
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "AAAA")
    (SORT-KEY = "STOP")
    (SORT-KEY = "ZZZZ")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-LAST TO BE "STOP"

TESTCASE "the next case still runs"
    MOCK RELEASE SORT-REC
    END-MOCK
    MOCK RETURN SORT-FILE ROWS
    (SORT-KEY = "CCCC")
    TERMINAL (WS-EOF = "Y")
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 1
    EXPECT WS-LAST TO BE "DONE"
