       IDENTIFICATION DIVISION.
       PROGRAM-ID. HANDRET.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RESP      PIC S9(8) COMP VALUE 0.
       01  WS-MSG       PIC X(20) VALUE SPACES.
       01  WS-AFTER     PIC X(20) VALUE SPACES.
       01  WS-MAPIN     PIC X(80).
       PROCEDURE DIVISION.
       MAIN-PARA.
           EXEC CICS HANDLE CONDITION MAPFAIL(MAPFAIL-PARA) END-EXEC
           EXEC CICS RECEIVE MAP('M1') MAPSET('MS1') INTO(WS-MAPIN)
           END-EXEC
           MOVE "RECEIVED" TO WS-MSG
           EXEC CICS RETURN END-EXEC.
       MAPFAIL-PARA.
           MOVE "MAPFAIL" TO WS-MSG
           EXEC CICS XCTL PROGRAM('MENU') RESP(WS-RESP) END-EXEC
           MOVE "XCTL-FAILED" TO WS-AFTER
           EXEC CICS RETURN END-EXEC.
