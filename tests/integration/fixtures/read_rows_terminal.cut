TESTSUITE "RDROWST row-driven READ terminated via TERMINAL group"

TESTCASE "consumes both rows in order then terminates on exhaustion"
    MOCK OPEN INV-FILE
    END-MOCK
    MOCK READ INV-FILE ROWS
        ( INV-QTY = 5 )
        ( INV-QTY = 12 )
        TERMINAL ( WS-EOF = "Y" )
    END-MOCK
    MOCK CLOSE INV-FILE
    END-MOCK
    PERFORM MAIN-PROCESS
    EXPECT WS-TOTAL-QTY TO BE 17
    EXPECT WS-ROW-COUNT TO BE 2
    EXPECT WS-EOF TO BE "Y"
    VERIFY READ INV-FILE WAS PERFORMED 3 TIMES
    VERIFY OPEN INV-FILE WAS PERFORMED ONCE
    VERIFY CLOSE INV-FILE WAS PERFORMED ONCE
