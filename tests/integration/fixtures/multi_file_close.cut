TESTSUITE "multi-file close"

TESTCASE "every file of the CLOSE is mocked and verified"
    MOCK CLOSE CHKFILE
    END-MOCK
    MOCK CLOSE STOPPAY
        FILE-STATUS IS "30"
    END-MOCK
    MOCK CLOSE CHKRPT
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-RESULT TO BE "STP-FAIL"
    EXPECT WS-CHK-ST TO BE "00"
    VERIFY CLOSE CHKFILE WAS CALLED ONCE
    VERIFY CLOSE STOPPAY WAS CALLED ONCE
    VERIFY CLOSE CHKRPT WAS CALLED ONCE
