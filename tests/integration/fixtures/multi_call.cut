TESTSUITE "stateful subprogram"

TESTCASE "a repeated key is a duplicate on the second call"
    MOCK CALL "AUDIT"
    END-MOCK
    MOVE "K1" TO WS-IN
    PERFORM 0000-ENTRY
    MOVE "K1" TO WS-IN
    PERFORM 0000-ENTRY
    EXPECT WS-STATUS TO BE "DU"
    EXPECT WS-CALLS TO BE 2
    VERIFY CALL "AUDIT" WAS CALLED 2 TIMES

TESTCASE "a new key is accepted"
    MOCK CALL "AUDIT"
    END-MOCK
    MOVE "K1" TO WS-IN
    PERFORM 0000-ENTRY
    MOVE "K2" TO WS-IN
    PERFORM 0000-ENTRY
    PERFORM 0000-ENTRY
    EXPECT WS-STATUS TO BE "DU"
    EXPECT WS-LAST TO BE "K2"
    EXPECT WS-CALLS TO BE 3
