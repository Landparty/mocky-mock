TESTSUITE "same-kind statements nested in clause bodies"
TESTCASE "two rows, the second one fails validation and has no reference"
    MOCK OPEN IN-FILE
    END-MOCK
    MOCK OPEN REF-FILE
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    MOCK CLOSE REF-FILE
    END-MOCK
    MOCK READ IN-FILE ROWS
        (IN-REC = "A")
        (IN-REC = "B")
    END-MOCK
    MOCK READ REF-FILE ROWS
        (REF-REC = "R1")
    END-MOCK
    MOCK CALL "VALIDATE"
        EVALUATE UT-VALIDATE-TALLY
            WHEN 2
                MOVE "EX" TO UT-MOCK-STATUS
        END-EVALUATE
    END-MOCK
    MOCK CALL "ERRLOG"
        CAPTURE ARG 1 INTO UT-CAP-ERRLOG-1
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-ERRS TO BE 1
    EXPECT WS-NOREF TO BE 1
    EXPECT UT-CAP-ERRLOG-1 TO BE "B"
    VERIFY READ IN-FILE WAS CALLED 3 TIMES
    VERIFY READ REF-FILE WAS CALLED 2 TIMES
    VERIFY CALL "VALIDATE" WAS CALLED 2 TIMES
    VERIFY CALL "ERRLOG" WAS CALLED ONCE
