TESTSUITE "DIVIDE GIVING ROUNDED"

TESTCASE "5 / 2 rounds up to 3, not truncated to 2"
    MOCK CALL "LOGRESULT"
        MOVE "OK" TO WS-LOG-STATUS
    END-MOCK
    MOVE 5 TO WS-NUM
    MOVE 2 TO WS-DEN
    PERFORM MAIN-PARA
    EXPECT WS-RESULT TO BE 3
    VERIFY "LOGRESULT" WAS CALLED ONCE

TESTCASE "7 / 2 rounds up to 4, not truncated to 3"
    MOCK CALL "LOGRESULT"
        MOVE "OK" TO WS-LOG-STATUS
    END-MOCK
    MOVE 7 TO WS-NUM
    MOVE 2 TO WS-DEN
    PERFORM MAIN-PARA
    EXPECT WS-RESULT TO BE 4
