TESTSUITE "nested clause bodies"
TESTCASE "two rows, second one fails validation"
    MOCK OPEN IN-FILE
    END-MOCK
    MOCK CLOSE IN-FILE
    END-MOCK
    MOCK READ IN-FILE ROWS
        (IN-REC = "A")
        (IN-REC = "B")
    END-MOCK
    MOCK CALL "EOFLOG"
    END-MOCK
    MOCK CALL "VALIDATE"
        EVALUATE UT-VALIDATE-TALLY
            WHEN 2
                MOVE "EX" TO UT-MOCK-STATUS
        END-EVALUATE
    END-MOCK
    MOCK WRITE ERR-REC
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-COUNT TO BE 2
    EXPECT WS-ERRS TO BE 1
    EXPECT ERR-REC TO BE "B"
    VERIFY CALL "VALIDATE" WAS CALLED 2 TIMES
    VERIFY CALL "EOFLOG" WAS CALLED ONCE
    VERIFY WRITE ERR-REC WAS CALLED ONCE
