TESTSUITE "record key outside the FD"

TESTCASE "a WRITE to the file keyed outside its FD is mocked"
    MOCK OPEN EXPORT-OUTPUT
    END-MOCK
    MOCK WRITE EXPORT-OUTPUT-RECORD
    END-MOCK
    MOCK CLOSE EXPORT-OUTPUT
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-RESULT TO BE "WRITTEN"
    EXPECT WS-WRITTEN TO BE 1
    VERIFY WRITE EXPORT-OUTPUT-RECORD WAS CALLED ONCE

TESTCASE "a failing WRITE still sets the file's status"
    MOCK OPEN EXPORT-OUTPUT
    END-MOCK
    MOCK WRITE EXPORT-OUTPUT-RECORD
        FILE-STATUS IS "22"
    END-MOCK
    MOCK CLOSE EXPORT-OUTPUT
    END-MOCK
    PERFORM MAIN-PARA
    EXPECT WS-RESULT TO BE "FAILED"
